/// std/regex — Pattern matching via POSIX extended regular expressions.
///
/// Usage: import "std/regex" as regex
///
/// Backed by the system's regcomp/regexec (POSIX ERE).
/// Capture groups supported via findGroups().

/// Test if a string matches a pattern.
/// Returns true if pattern matches anywhere in the string.
///
/// Example:
///   regex.matches("hello world", "wor") → true
///   regex.matches("abc123", "[0-9]+") → true
fn matches(s: string, pattern: string) -> bool {
    return haki_regex_matches(s, pattern)
}

/// Find the first match of pattern in s.
/// Returns (match, null) if found, ("", Error) if not found or invalid pattern.
fn find(s: string, pattern: string) -> (string, Error?) {
    return haki_regex_find(s, pattern)
}

/// Replace all matches of pattern in s with replacement.
/// Returns the new string (original unchanged).
fn replaceAll(s: string, pattern: string, replacement: string) -> string {
    return haki_regex_replace_all(s, pattern, replacement)
}

/// Split s on pattern. Returns Array<string>.
/// Example: regex.split("one,two,,three", ",+") → ["one","two","three"]
fn split(s: string, pattern: string) -> Array<string> {
    return haki_regex_split(s, pattern)
}

/// Find all capture groups in the first match of pattern in s.
/// Index 0 is the full match; indices 1..N are capture groups.
/// Returns an empty array if there is no match.
///
/// Example:
///   regex.findGroups("2024-01-15", "([0-9]{4})-([0-9]{2})-([0-9]{2})")
///   → ["2024-01-15", "2024", "01", "15"]
fn findGroups(s: string, pattern: string) -> Array<string> {
    return haki_regex_find_groups(s, pattern)
}

// ── C functions registered in builtins.rs (no extern "c" needed) ─────────────
// haki_regex_matches, haki_regex_find, haki_regex_replace_all,
// haki_regex_split, haki_regex_find_groups
