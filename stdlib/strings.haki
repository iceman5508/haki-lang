/// Repeat string s n times.
fn repeat(s: string, n: int) -> string {
    let result = ""
    let i = 0
    while i < n {
        result = result + s
        i = i + 1
    }
    return result
}

/// True if s is empty (zero length).
fn isEmpty(s: string) -> bool {
    return string_length(s) == 0
}

/// Pad s on the left with padChar to reach width.
fn padLeft(s: string, width: int, padChar: string) -> string {
    let result = s
    while string_length(result) < width {
        result = padChar + result
    }
    return result
}

/// Pad s on the right with padChar to reach width.
fn padRight(s: string, width: int, padChar: string) -> string {
    let result = s
    while string_length(result) < width {
        result = result + padChar
    }
    return result
}

/// Join array of strings with separator.
fn join(parts: Array<string>, sep: string) -> string {
    return parts.join(sep)
}

/// Count non-overlapping occurrences of sub in s.
fn count(s: string, sub: string) -> int {
    if string_length(sub) == 0 { return 0 }
    const parts = s.split(sub)
    return parts.length - 1
}

/// Remove leading whitespace from s.
fn trimLeft(s: string) -> string {
    return s.trimStart()
}

/// Remove trailing whitespace from s.
fn trimRight(s: string) -> string {
    return s.trimEnd()
}

/// Replace all occurrences of from with to in s.
fn replaceAll(s: string, from: string, to: string) -> string {
    return s.replace(from, to)
}

/// Return the index of the first occurrence of sub in s, or -1 if not found.
fn indexOf(s: string, sub: string) -> int {
    return s.indexOf(sub)
}

/// Extract the substring of s from start (inclusive) to end (exclusive).
fn substring(s: string, start: int, end: int) -> string {
    return s.substring(start, end)
}
