/// std/env — Environment variables and process information.
///
/// Usage: import "std/env" as env
///
/// All functions delegate to C runtime helpers.

/// Get the value of an environment variable.
/// Returns (value, null) on success, ("", Error) if not set.
fn get(name: string) -> (string, Error?) {
    return haki_env_get(name)
}

/// Get an environment variable with a default value.
/// Returns the default if the variable is not set.
fn getOrDefault(name: string, default: string) -> string {
    const val, err = haki_env_get(name)
    if err != null { return default }
    return val
}

/// Set an environment variable for the current process.
fn set(name: string, value: string) -> Error? {
    return haki_env_set(name, value)
}

/// Remove an environment variable.
fn unset(name: string) -> Error? {
    return haki_env_unset(name)
}

/// Get the current working directory.
fn cwd() -> (string, Error?) {
    return haki_env_cwd()
}

/// Change the current working directory.
fn chdir(path: string) -> Error? {
    return haki_env_chdir(path)
}

/// Get the home directory of the current user.
fn home() -> (string, Error?) {
    const val, err = haki_env_get("HOME")
    if err == null { return val, null }
    const val2, err2 = haki_env_get("USERPROFILE")
    if err2 == null { return val2, null }
    return "", Error(message: "cannot determine home directory")
}

/// Get all command-line arguments (same as the builtin argv()).
fn args() -> Array<string> {
    return argv()
}
