/// Absolute value of an integer.
fn abs(n: int) -> int {
    if n < 0 { return -n }
    return n
}

/// Larger of two integers.
fn max(a: int, b: int) -> int {
    if a > b { return a }
    return b
}

/// Smaller of two integers.
fn min(a: int, b: int) -> int {
    if a < b { return a }
    return b
}

/// Clamp n to the range [lo, hi].
fn clamp(n: int, lo: int, hi: int) -> int {
    return min(max(n, lo), hi)
}

/// Integer power: base^exp. Returns 1 for exp <= 0.
fn pow(base: int, exp: int) -> int {
    if exp <= 0 { return 1 }
    let result = 1
    let i = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}
