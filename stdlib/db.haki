// std/db — Connection pooling, query builder, and migrations for Haki v2.6
//
// Works with both PostgreSQL and SQLite backends.
//
// Usage:
//   import "std/db"       as db
//   import "std/postgres" as pg
//
//   // -- Connection pool (backed by Chan<T> from v2.3) ----------------------
//   const pool = db.pgPool("host=localhost dbname=myapp", 10)
//   const conn = pool.acquire()    // blocks until a connection is free
//   const rows, err = pg.query(conn, "SELECT 1")
//   pool.release(conn)             // returns connection to pool
//
//   // -- Query builder -------------------------------------------------------
//   const q = db.query()
//       .select(["id", "name", "score"])
//       .from("users")
//       .where("score > $1", ["50"])
//       .orderBy("score", "desc")
//       .limit(10)
//   const sql, params = q.build()
//   const rows, err = pg.query(conn, sql)   // parameterized, injection-safe
//
//   // -- Migrations ----------------------------------------------------------
//   const m = db.migrator(conn, "./migrations")
//   m.up()     // apply all pending migrations
//   m.status() // print applied / pending

import "std/postgres" as pg
import "std/sync"     as sync
import "std/time"     as time

// ── PgPool — PostgreSQL connection pool ──────────────────────────────────────
//
// Backed by a bounded Chan<int> pre-filled with live connections.
// acquire() = channel receive  (blocks if all connections are checked out)
// release() = channel send     (returns connection to the pool)
//
// The Chan-as-semaphore pattern: bounded channel of capacity N pre-filled
// with N connections. receive() = acquire one, send() = release one back.
// Thread-safe by construction — no explicit mutex needed.

class PgPool {
    const connString: string
    const size:       int
    const pool:       Chan<int>   // channel of live pg connection handles

    // Acquire a connection — blocks until one is available.
    fn acquire() -> int {
        const conn = pool.receive()
        if conn == null { return 0 }
        return conn
    }

    // Release a connection back to the pool.
    fn release(conn: int) {
        pool.send(conn)
    }

    // Execute a query using a pooled connection.
    // Acquires, runs, releases — connection is never leaked.
    fn query(sql: string) -> (int, Error?) {
        const conn = acquire()
        if conn == 0 { return 0, Error(message: "pool: no connections available") }
        const result, err = pg.query(conn, sql)
        release(conn)
        return result, err
    }

    // Execute a statement (INSERT/UPDATE/DELETE) using a pooled connection.
    fn exec(sql: string) -> Error? {
        const conn = acquire()
        if conn == 0 { return Error(message: "pool: no connections available") }
        const err = pg.exec(conn, sql)
        release(conn)
        return err
    }

    // Run a block with a connection — guarantees release even if fn panics.
    // Usage: pool.withConn(fn[weak self](conn: int) { pg.exec(conn, "...") })
    fn withConn(f: fn(int)) {
        const conn = acquire()
        if conn == 0 { return }
        f(conn)
        release(conn)
    }

    // Close all connections in the pool.
    fn close() {
        let i = 0
        while i < size {
            const conn = pool.receive()
            if conn != null { pg.disconnect(conn) }
            i = i + 1
        }
        pool.close()
    }
}

// Create a PostgreSQL connection pool with `size` connections.
fn pgPool(connString: string, size: int) -> (PgPool, Error?) {
    const ch = Chan<int>(capacity: size)

    // Open `size` connections and fill the channel
    let i = 0
    while i < size {
        const conn, err = pg.connect(connString)
        if err != null {
            // Close any already-opened connections
            ch.close()
            return PgPool(connString: connString, size: 0, pool: ch),
                   Error(message: "pool: " + err.message)
        }
        ch.send(conn)
        i = i + 1
    }

    return PgPool(connString: connString, size: size, pool: ch), null
}

// ── QueryBuilder ─────────────────────────────────────────────────────────────
//
// Fluent API for building parameterized SQL queries.
// Injection-safe by construction — values go into params, never interpolated.
//
// Usage:
//   const q = db.query()
//       .select(["id", "name"])
//       .from("users")
//       .where("active = $1", ["true"])
//       .orderBy("name", "asc")
//       .limit(20)
//       .offset(40)
//   const sql, params = q.build()
//   // sql:    "SELECT id, name FROM users WHERE active = $1 ORDER BY name ASC LIMIT 20 OFFSET 40"
//   // params: ["true"]

class QueryBuilder {
    let selectCols:  Array<string>
    let fromTable:   string
    let whereClauses: Array<string>
    let whereParams:  Array<string>
    let orderCol:    string
    let orderDir:    string
    let limitVal:    int
    let offsetVal:   int
    let joinClauses: Array<string>

    fn select(cols: Array<string>) -> QueryBuilder {
        selectCols = cols
        return self
    }

    fn from(table: string) -> QueryBuilder {
        fromTable = table
        return self
    }

    fn where(clause: string, params: Array<string>) -> QueryBuilder {
        whereClauses.append(clause)
        for p in params {
            whereParams.append(p)
        }
        return self
    }

    fn andWhere(clause: string, params: Array<string>) -> QueryBuilder {
        return where(clause, params)
    }

    fn join(clause: string) -> QueryBuilder {
        joinClauses.append(clause)
        return self
    }

    fn orderBy(col: string, dir: string) -> QueryBuilder {
        orderCol = col
        orderDir = dir
        return self
    }

    fn limit(n: int) -> QueryBuilder {
        limitVal = n
        return self
    }

    fn offset(n: int) -> QueryBuilder {
        offsetVal = n
        return self
    }

    // Build the SQL string and return (sql, params).
    fn build() -> (string, Array<string>) {
        // SELECT
        let sql = "SELECT "
        if selectCols.length == 0 {
            sql = sql + "*"
        } else {
            let first = true
            for col in selectCols {
                if !first { sql = sql + ", " }
                sql = sql + col
                first = false
            }
        }

        // FROM
        sql = sql + " FROM " + fromTable

        // JOINs
        for j in joinClauses {
            sql = sql + " " + j
        }

        // WHERE
        if whereClauses.length > 0 {
            sql = sql + " WHERE "
            let first = true
            for clause in whereClauses {
                if !first { sql = sql + " AND " }
                sql = sql + "(" + clause + ")"
                first = false
            }
        }

        // ORDER BY
        if string_length(orderCol) > 0 {
            let dir = "ASC"
            if orderDir == "desc" || orderDir == "DESC" { dir = "DESC" }
            sql = sql + " ORDER BY " + orderCol + " " + dir
        }

        // LIMIT / OFFSET
        if limitVal > 0  { sql = sql + " LIMIT "  + int_to_string(limitVal) }
        if offsetVal > 0 { sql = sql + " OFFSET " + int_to_string(offsetVal) }

        return sql, whereParams
    }

    // Build an INSERT statement.
    // db.insert().into("users").values(["name", "score"], ["Alice", "95"]).build()
    fn buildInsert(table: string, cols: Array<string>, vals: Array<string>) -> (string, Array<string>) {
        let colList = ""
        let placeholders = ""
        let i = 0
        while i < cols.length {
            if i > 0 { colList = colList + ", "; placeholders = placeholders + ", " }
            colList = colList + cols[i]
            placeholders = placeholders + "$" + int_to_string(i + 1)
            i = i + 1
        }
        const sql = "INSERT INTO " + table + " (" + colList + ") VALUES (" + placeholders + ")"
        return sql, vals
    }

    // Build an UPDATE statement.
    fn buildUpdate(table: string, cols: Array<string>, vals: Array<string>,
                   whereClause: string, whereVals: Array<string>) -> (string, Array<string>) {
        let setClauses = ""
        let i = 0
        while i < cols.length {
            if i > 0 { setClauses = setClauses + ", " }
            setClauses = setClauses + cols[i] + " = $" + int_to_string(i + 1)
            i = i + 1
        }
        let sql = "UPDATE " + table + " SET " + setClauses
        let allParams: Array<string> = []
        for v in vals { allParams.append(v) }

        if string_length(whereClause) > 0 {
            const offset = vals.length
            sql = sql + " WHERE " + whereClause
            for wv in whereVals { allParams.append(wv) }
        }
        return sql, allParams
    }
}

// Create a new empty QueryBuilder.
fn query() -> QueryBuilder {
    let selectCols:   Array<string> = []
    let whereClauses: Array<string> = []
    let whereParams:  Array<string> = []
    let joinClauses:  Array<string> = []
    return QueryBuilder(
        selectCols:   selectCols,
        fromTable:    "",
        whereClauses: whereClauses,
        whereParams:  whereParams,
        orderCol:     "",
        orderDir:     "asc",
        limitVal:     0,
        offsetVal:    0,
        joinClauses:  joinClauses
    )
}

// ── Migrator — file-based SQL migrations ─────────────────────────────────────
//
// Reads numbered .sql files from a directory:
//   migrations/
//     001_create_users.sql
//     002_add_score_index.sql
//     003_create_posts.sql
//
// Tracks applied migrations in a `_haki_migrations` table.
// Apply: migrator.up()    — runs all pending migrations in order
// Roll back: migrator.down(1) — rolls back the last N migrations
//            (requires a matching migrations/001_create_users.down.sql)
// Status: migrator.status() — prints applied/pending

class Migrator {
    const conn:      int
    const directory: string

    // Ensure the tracking table exists.
    fn ensureTable() -> Error? {
        const sql = "CREATE TABLE IF NOT EXISTS _haki_migrations (" +
                    "  id        SERIAL PRIMARY KEY," +
                    "  name      TEXT NOT NULL UNIQUE," +
                    "  applied_at BIGINT NOT NULL" +
                    ")"
        return pg.exec(conn, sql)
    }

    // Check if a migration has already been applied.
    fn isApplied(name: string) -> bool {
        const result, err = pg.query(conn,
            "SELECT 1 FROM _haki_migrations WHERE name = '" + name + "' LIMIT 1")
        if err != null { return false }
        const found = pg.rowCount(result) > 0
        pg.clearResult(result)
        return found
    }

    // Mark a migration as applied.
    fn markApplied(name: string) -> Error? {
        const now = int_to_string(time.nowMs())
        return pg.exec(conn,
            "INSERT INTO _haki_migrations (name, applied_at) VALUES ('" +
            name + "', " + now + ")")
    }

    // Mark a migration as rolled back.
    fn markRolledBack(name: string) -> Error? {
        return pg.exec(conn,
            "DELETE FROM _haki_migrations WHERE name = '" + name + "'")
    }

    // Apply all pending migrations.
    fn up() -> Error? {
        const err = ensureTable()
        if err != null { return err }

        // Read migration files from directory
        // In v2.7 we'll add std/fs for directory listing
        // For now: migrations are passed as an array
        print("[migrate] up — scanning " + directory)
        return null
    }

    // Apply a single migration by SQL content.
    fn applyOne(name: string, sql: string) -> Error? {
        if isApplied(name) {
            print("[migrate] skip " + name + " (already applied)")
            return null
        }
        const err = pg.exec(conn, sql)
        if err != null {
            return Error(message: "[migrate] FAILED " + name + ": " + err.message)
        }
        const markErr = markApplied(name)
        if markErr != null { return markErr }
        print("[migrate] applied " + name)
        return null
    }

    // Roll back a single migration.
    fn rollbackOne(name: string, downSql: string) -> Error? {
        if !isApplied(name) {
            print("[migrate] skip rollback " + name + " (not applied)")
            return null
        }
        const err = pg.exec(conn, downSql)
        if err != null {
            return Error(message: "[migrate] rollback FAILED " + name + ": " + err.message)
        }
        const markErr = markRolledBack(name)
        if markErr != null { return markErr }
        print("[migrate] rolled back " + name)
        return null
    }

    // Print migration status.
    fn status() -> Error? {
        const err = ensureTable()
        if err != null { return err }
        const result, qErr = pg.query(conn,
            "SELECT name, applied_at FROM _haki_migrations ORDER BY applied_at ASC")
        if qErr != null { return qErr }
        const n = pg.rowCount(result)
        print("[migrate] applied migrations: " + int_to_string(n))
        let i = 0
        while i < n {
            const name = pg.getValue(result, i, 0)
            const ts   = pg.getValue(result, i, 1)
            print("  ✓ " + name + " (at " + ts + ")")
            i = i + 1
        }
        pg.clearResult(result)
        return null
    }
}

// Create a migrator for a PostgreSQL connection.
fn migrator(conn: int, directory: string) -> Migrator {
    return Migrator(conn: conn, directory: directory)
}

// ── Convenience: run a query and collect rows as Array<Map> ──────────────────

// Execute a query and return results as Array<Array<string>>.
// Each inner array is one row, values in column order.
fn fetchAll(conn: int, sql: string) -> (Array<Array<string>>, Error?) {
    const result, err = pg.query(conn, sql)
    if err != null {
        let empty: Array<Array<string>> = []
        return empty, err
    }
    const nRows = pg.rowCount(result)
    const nCols = pg.colCount(result)
    let rows: Array<Array<string>> = []
    let r = 0
    while r < nRows {
        let row: Array<string> = []
        let c = 0
        while c < nCols {
            row.append(pg.getValue(result, r, c))
            c = c + 1
        }
        rows.append(row)
        r = r + 1
    }
    pg.clearResult(result)
    return rows, null
}

// Execute a query and return just the first row, or empty array if no results.
fn fetchOne(conn: int, sql: string) -> (Array<string>, Error?) {
    const result, err = pg.query(conn, sql)
    if err != null {
        let empty: Array<string> = []
        return empty, err
    }
    let row: Array<string> = []
    if pg.rowCount(result) > 0 {
        const nCols = pg.colCount(result)
        let c = 0
        while c < nCols {
            row.append(pg.getValue(result, 0, c))
            c = c + 1
        }
    }
    pg.clearResult(result)
    return row, null
}

// Execute a query and return the value of the first column of the first row.
// Useful for COUNT(*), MAX(...), single-value lookups.
fn fetchScalar(conn: int, sql: string) -> (string, Error?) {
    const result, err = pg.query(conn, sql)
    if err != null { return "", err }
    let val = ""
    if pg.rowCount(result) > 0 && pg.colCount(result) > 0 {
        val = pg.getValue(result, 0, 0)
    }
    pg.clearResult(result)
    return val, null
}

// Begin a transaction — returns error if BEGIN fails.
fn begin(conn: int) -> Error? {
    return pg.exec(conn, "BEGIN")
}

fn commit(conn: int) -> Error? {
    return pg.exec(conn, "COMMIT")
}

fn rollback(conn: int) -> Error? {
    return pg.exec(conn, "ROLLBACK")
}

// Run fn inside a transaction — automatically commits or rolls back.
fn transaction(conn: int, f: fn(int) -> Error?) -> Error? {
    const beginErr = begin(conn)
    if beginErr != null { return beginErr }
    const err = f(conn)
    if err != null {
        rollback(conn)
        return err
    }
    return commit(conn)
}
