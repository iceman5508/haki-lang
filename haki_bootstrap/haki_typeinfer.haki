// haki_typeinfer.haki — Type inference pass for the Haki bootstrap compiler.
//
// Produces TypedExpr nodes from raw compiler.Expr nodes by threading type
// information from the SymTable down through expression trees.
//
// Scope (v2.1): handles exactly what the bootstrap corpus uses.
//   - Literal types: int, float, bool, string, null
//   - Variable lookup from a scope chain
//   - Binary operators: type-correct + vs string_concat, == vs strcmp, etc.
//   - Function call return type from SymTable
//   - Field access (conservative: void* for unknown)
//   - If/match expressions (type of first branch)
//   - Array literals → Array<T>
//
// Does NOT handle: generics instantiation, protocol dispatch, closures,
// complex inference chains. These aren't needed for the bootstrap corpus.

import "./haki_compiler" as compiler
import "./haki_typeck"   as typeck

// ── TypedExpr ──────────────────────────────────────────────────────────────────

// All TypedExpr variants carry a `ty` string field:
//   "int"    → int64_t in C
//   "float"  → double in C
//   "bool"   → int8_t in C
//   "string" → const char* in C
//   "void"   → void in C
//   anything else → void* in C (named/generic types, arrays, etc.)

struct TypedExpr {
    const kind: compiler.Expr   // original raw expr — reused for structure
    const ty:   string          // resolved type string
}

struct TypedStmt {
    const kind:    compiler.Stmt  // original raw stmt
    const declTy:  string         // for let/const: the declared/inferred type
}

// ── Scope ─────────────────────────────────────────────────────────────────────

// A flat scope chain: variable name → type string.
// We use parallel arrays rather than Map to avoid Map generics complexity.
struct Scope {
    let names: Array<string>
    let types: Array<string>
}

fn scopeNew() -> Scope {
    return Scope(names: [], types: [])
}

fn scopeSet(sc: Scope, name: string, ty: string) {
    // Update if exists
    let i = 0
    while i < sc.names.length {
        if sc.names[i] == name {
            sc.types[i] = ty
            return
        }
        i = i + 1
    }
    // Add new
    sc.names.append(name)
    sc.types.append(ty)
}

fn scopeGet(sc: Scope, name: string) -> string {
    let i = 0
    while i < sc.names.length {
        if sc.names[i] == name { return sc.types[i] }
        i = i + 1
    }
    return "void*"   // unknown → opaque pointer
}

// Like scopeGet but returns "" (not "void*") when the name is not found.
// Used for meta-scope lookups like enum discriminants ("__v__VarName") and
// struct field lists ("__sf__StructName").
fn scopeLookup(sc: Scope, name: string) -> string {
    let i = 0
    while i < sc.names.length {
        if sc.names[i] == name { return sc.types[i] }
        i = i + 1
    }
    return ""
}

fn scopeCopy(sc: Scope) -> Scope {
    let copy = scopeNew()
    let i = 0
    while i < sc.names.length {
        copy.names.append(sc.names[i])
        copy.types.append(sc.types[i])
        i = i + 1
    }
    return copy
}

// ── Primitive type helpers ─────────────────────────────────────────────────────

fn isIntTy(ty: string) -> bool {
    return ty == "int"
}

fn isFloatTy(ty: string) -> bool {
    return ty == "float"
}

fn isStringTy(ty: string) -> bool {
    return ty == "string"
}

fn isBoolTy(ty: string) -> bool {
    return ty == "bool"
}

fn isNumericTy(ty: string) -> bool {
    if ty == "int"   { return true }
    if ty == "float" { return true }
    return false
}

// Return the C operator string for a binary op given the operand type.
fn binaryOpC(op: string, ty: string) -> string {
    // Arithmetic
    if op == "+"  && isNumericTy(ty)  { return "+" }
    if op == "-"  && isNumericTy(ty)  { return "-" }
    if op == "*"  && isNumericTy(ty)  { return "*" }
    if op == "/"  && isNumericTy(ty)  { return "/" }
    if op == "%"  && isNumericTy(ty)  { return "%" }
    // Comparisons on numbers
    if op == "<"  && isNumericTy(ty)  { return "<" }
    if op == ">"  && isNumericTy(ty)  { return ">" }
    if op == "<=" && isNumericTy(ty)  { return "<=" }
    if op == ">=" && isNumericTy(ty)  { return ">=" }
    if op == "==" && isNumericTy(ty)  { return "==" }
    if op == "!=" && isNumericTy(ty)  { return "!=" }
    // Bool operators
    if op == "==" && isBoolTy(ty)     { return "==" }
    if op == "!=" && isBoolTy(ty)     { return "!=" }
    if op == "&&"                     { return "&&" }
    if op == "||"                     { return "||" }
    // Ordering on strings is lexicographic via strcmp. Without these the
    // fallthrough emitted a raw C "<" on two const char*, silently comparing
    // pointer addresses instead of contents.
    if op == "<"  && isStringTy(ty)   { return "string_lt" }
    if op == ">"  && isStringTy(ty)   { return "string_gt" }
    if op == "<=" && isStringTy(ty)   { return "string_le" }
    if op == ">=" && isStringTy(ty)   { return "string_ge" }
    // String concat
    if op == "+"  && isStringTy(ty)   { return "string_concat" }
    // String equality via strcmp
    if op == "==" && isStringTy(ty)   { return "string_eq" }
    if op == "!=" && isStringTy(ty)   { return "string_neq" }
    // Pointer equality (null checks, named types)
    if op == "==" { return "ptr_eq" }
    if op == "!=" { return "ptr_neq" }
    // Fallback: + on any non-numeric type is string concat (void* from failed inference)
    if op == "+"  { return "string_concat" }
    return op
}

// ── Infer return type of a known builtin/runtime call ─────────────────────────

fn builtinReturnTy(name: string) -> string {
    // Print functions → void
    if name == "print"         { return "void" }
    if name == "print_int"     { return "void" }
    if name == "print_float"   { return "void" }
    if name == "print_bool"    { return "void" }
    // String ops → string
    if name == "int_to_string"    { return "string" }
    if name == "float_to_string"  { return "string" }
    if name == "bool_to_string"   { return "string" }
    if name == "string_length"    { return "int" }
    if name == "string_concat"    { return "string" }
    if name == "string_substring" { return "string" }
    if name == "string_contains"  { return "bool" }
    if name == "string_split"     { return "string" }  // Array<string> but we use void*
    if name == "string_to_upper"  { return "string" }
    if name == "string_to_lower"  { return "string" }
    if name == "string_trim"      { return "string" }
    // Numeric
    if name == "int_to_float"  { return "float" }
    if name == "float_to_int"  { return "int" }
    // File I/O → tuple → void*
    if name == "readFile"   { return "void*" }
    if name == "writeFile"  { return "void*" }
    // Array ops → int or element or void*
    if name == "haki_array_length" { return "int" }
    // argv → Array<string>
    if name == "argv" { return "Array<string>" }
    // Panic
    if name == "panic" { return "void" }
    return "void*"
}

// ── Type inference for expressions ────────────────────────────────────────────

// ── Generic call support ──────────────────────────────────────────────────────

/// Split a meta string on "|".
fn splitBars(s: string) -> Array<string> {
    let parts: Array<string> = []
    let cur = ""
    let i = 0
    while i < string_length(s) {
        const ch = s.substring(i, i + 1)
        if ch == "|" {
            parts.append(cur)
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    parts.append(cur)
    return parts
}

/// Split a comma-separated list.
fn splitCommas(s: string) -> Array<string> {
    let parts: Array<string> = []
    let cur = ""
    let i = 0
    while i < string_length(s) {
        const ch = s.substring(i, i + 1)
        if ch == "," {
            parts.append(cur)
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    if string_length(cur) > 0 { parts.append(cur) }
    return parts
}

/// Split on an arbitrary single-character separator. Capture lists cannot use
/// commas as their separator because a captured `Map<string,int>` contains one.
fn splitOn(s: string, sep: string) -> Array<string> {
    let parts: Array<string> = []
    let cur = ""
    let i = 0
    while i < string_length(s) {
        const ch = s.substring(i, i + 1)
        if ch == sep {
            parts.append(cur)
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    if string_length(cur) > 0 { parts.append(cur) }
    return parts
}

/// Single-uppercase-letter type names are type parameters (bootstrap subset).
fn isTypeParam(ty: string) -> bool {
    if string_length(ty) != 1 { return false }
    if ty == "T" || ty == "U" || ty == "V" || ty == "K" || ty == "E" { return true }
    return false
}

/// Resolve the result type of a call to a generic template.
/// Returns "" when the answer is unknown and the caller should fall through.
fn genericCallRetTy(meta: string, args: Array<compiler.Expr>, sc: Scope, sym: typeck.SymTable) -> string {
    const parts = splitBars(meta)
    if parts.length < 3 { return "" }
    const declTys = splitCommas(parts[1])
    const retTy   = parts[2]
    if !isTypeParam(retTy) { return retTy }
    let i = 0
    while i < declTys.length {
        if declTys[i] == retTy && i < args.length {
            return inferExprTy(args[i], sc, sym)
        }
        i = i + 1
    }
    return ""
}

fn inferExprTy(e: compiler.Expr, sc: Scope, sym: typeck.SymTable) -> string {
    const tag = match e {
        EInt(n)             { yield "int_lit" }
        EBool(b)            { yield "bool_lit" }
        ENull               { yield "null" }
        EString(s)          { yield "string_lit" }
        EIdent(n)           { yield "ident" }
        EUnary(op, inner)   { yield "unary" }
        EBinary(op, l, r)   { yield "binary" }
        ECall(n, args)      { yield "call" }
        ENamedCall(n, args) { yield "namedcall" }
        EField(recv, f)     { yield "field" }
        EMethodCall(r,m,ma) { yield "method" }
        EIndex(a, idx)      { yield "index" }
        EArray(elems)       { yield "array" }
        EIf(c, th, el)      { yield "if" }
        EMatch(s, arms)     { yield "match" }
        EBlock(stmts)       { yield "block" }
        EAsync(inner)       { yield "async" }
        EFnLit(lf)          { yield "fnlit" }
        _                   { yield "unknown" }
    }

    if tag == "fnlit" {
        const lf = match e { EFnLit(lf) { yield lf } _ { yield compiler.emptyFnDef() } }
        return compiler.fnDefTyStr(lf)
    }

    if tag == "int_lit"    { return "int" }
    if tag == "bool_lit"   { return "bool" }
    if tag == "null"       { return "void*" }
    if tag == "string_lit" { return "string" }

    // Named constructor call (ENamedCall) → returns the struct type name
    if tag == "namedcall" {
        const name = match e { ENamedCall(n, args) { yield n } _ { yield "" } }
        return name
    }

    if tag == "ident" {
        const name = match e { EIdent(n) { yield n } _ { yield "" } }
        const directTy = scopeGet(sc, name)
        if directTy != "void*" { return directTy }
        // Fall back to __selffld__ entry (class fields injected by emitFn)
        const sfTy = scopeLookup(sc, "__selffld__" + name)
        if string_length(sfTy) > 0 { return sfTy }
        return "void*"
    }

    if tag == "unary" {
        const op    = match e { EUnary(op, inner) { yield op }    _ { yield "" } }
        const inner = match e { EUnary(op, inner) { yield inner } _ { yield compiler.nullExpr() } }
        if op == "!" { return "bool" }
        if op == "-" {
            const ity = inferExprTy(inner, sc, sym)
            return ity  // -int → int, -float → float
        }
        return "void*"
    }

    if tag == "binary" {
        const op = match e { EBinary(op, l, r) { yield op } _ { yield "" } }
        const l  = match e { EBinary(op, l, r) { yield l }  _ { yield compiler.nullExpr() } }
        // Infer type of left operand — determines the operator semantics
        const lty = inferExprTy(l, sc, sym)
        // && and || always bool
        if op == "&&" || op == "||" { return "bool" }
        // Comparisons always bool
        if op == "==" || op == "!=" { return "bool" }
        if op == "<"  || op == ">"  { return "bool" }
        if op == "<=" || op == ">=" { return "bool" }
        // Arithmetic: result same type as operands
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            return lty
        }
        return lty
    }

    if tag == "call" {
        const name = match e { ECall(n, args) { yield n } _ { yield "" } }
        const args = match e { ECall(n, args) { yield args } _ { yield compiler.emptyExprs() } }

        // Multi-return tuple unpacking: __mr_get_N(tupleVar) → Nth element type.
        // The tupleVar was previously stored in scope with the full tuple type string
        // "(T0, T1, ...)" so we can extract the Nth element's type.
        if string_length(name) > 9 && name.substring(0, 9) == "__mr_get_" {
            const idxStr = name.substring(9, string_length(name))
            let idx = 0
            let si = 0
            while si < string_length(idxStr) {
                const ch = idxStr.substring(si, si + 1)
                if ch == "0" { idx = idx * 10 + 0 }
                else if ch == "1" { idx = idx * 10 + 1 }
                else if ch == "2" { idx = idx * 10 + 2 }
                else if ch == "3" { idx = idx * 10 + 3 }
                else if ch == "4" { idx = idx * 10 + 4 }
                else if ch == "5" { idx = idx * 10 + 5 }
                else if ch == "6" { idx = idx * 10 + 6 }
                else if ch == "7" { idx = idx * 10 + 7 }
                else if ch == "8" { idx = idx * 10 + 8 }
                else if ch == "9" { idx = idx * 10 + 9 }
                si = si + 1
            }
            if args.length > 0 {
                const tupleVarName = match args[0] { EIdent(n) { yield n } _ { yield "" } }
                if string_length(tupleVarName) > 0 {
                    const tupleTy = scopeLookup(sc, tupleVarName)
                    // Parse "(T0, T1, T2)" to get element at idx
                    // tupleTy starts with "(" and ends with ")"
                    const tn = string_length(tupleTy)
                    if tn > 2 && tupleTy.substring(0, 1) == "(" {
                        // Strip outer parens → "T0, T1, T2"
                        const inner = tupleTy.substring(1, tn - 1)
                        // Split by ", " to get elements (simple split: find commas at depth 0)
                        let count = 0
                        let elemStart = 0
                        let depth = 0
                        let ci = 0
                        while ci < string_length(inner) {
                            const ch2 = inner.substring(ci, ci + 1)
                            if ch2 == "<" || ch2 == "(" { depth = depth + 1 }
                            else if ch2 == ">" || ch2 == ")" { depth = depth - 1 }
                            else if ch2 == "," && depth == 0 {
                                if count == idx {
                                    return inner.substring(elemStart, ci)
                                }
                                count = count + 1
                                elemStart = ci + 2  // skip ", "
                            }
                            ci = ci + 1
                        }
                        // Last element
                        if count == idx {
                            return inner.substring(elemStart, string_length(inner))
                        }
                    }
                }
            }
        }

        // Generic call: the emitter injects "__gen__<name>" as
        // "<template>|<declParamTys>|<declRetTy>". If the declared return type
        // is one of the type parameters, the call's type is whatever the
        // corresponding argument turned out to be — which is what makes nested
        // generic calls like identity(identity(x)) infer correctly.
        const genMeta = scopeLookup(sc, "__gen__" + name)
        if string_length(genMeta) > 0 {
            const gRet = genericCallRetTy(genMeta, args, sc, sym)
            if string_length(gRet) > 0 { return gRet }
        }

        // `__typed_ctor__Chan<int>` — the parser folded the declared type into
        // the constructor call because the constructor itself is zero-arg.
        if string_length(name) > 14 && name.substring(0, 14) == "__typed_ctor__" {
            return name.substring(14, string_length(name))
        }
        // Check builtin first
        const bty = builtinReturnTy(name)
        if bty != "void*" { return bty }
        // Check meta-scope for injected function return types (set by emitter via "__fn__" prefix)
        const metaTy = scopeLookup(sc, "__fn__" + name)
        if string_length(metaTy) > 0 { return metaTy }
        // Check sym table via helper that avoids multi-return void* binding issue
        const retTyStr = typeck.symLookupFnRetTyStr(sym, name)
        if retTyStr == "int"    { return "int" }
        if retTyStr == "float"  { return "float" }
        if retTyStr == "bool"   { return "bool" }
        if retTyStr == "string" { return "string" }
        if retTyStr == "void"   { return "void" }
        // Check if this is a registered struct constructor (meta-scope has "__sf__StructName" entry)
        const sfStr = scopeLookup(sc, "__sf__" + name)
        if string_length(sfStr) > 0 { return name }
        return "void*"
    }

    if tag == "field" {
        const recv = match e { EField(recv, f) { yield recv } _ { yield compiler.nullExpr() } }
        const f    = match e { EField(recv, f) { yield f }    _ { yield "" } }
        // .length on arrays → int
        if f == "length" { return "int" }
        // .message on errors → string
        if f == "message" { return "string" }
        // Look up struct field type from meta-scope using receiver type
        const recvTy = inferExprTy(recv, sc, sym)
        let baseTy = recvTy
        // Strip module prefix (take suffix after last ".")
        let di = 0
        while di < string_length(recvTy) {
            if recvTy.substring(di, di + 1) == "." {
                baseTy = recvTy.substring(di + 1, string_length(recvTy))
            }
            di = di + 1
        }
        // Strip trailing "*" if present
        const blen = string_length(baseTy)
        if blen > 0 && baseTy.substring(blen - 1, blen) == "*" {
            baseTy = baseTy.substring(0, blen - 1)
        }
        const fieldTy = scopeLookup(sc, "__sft__" + baseTy + "__" + f)
        if string_length(fieldTy) > 0 { return fieldTy }
        return "void*"
    }

    if tag == "method" {
        const recv = match e { EMethodCall(r,m,ma) { yield r } _ { yield compiler.nullExpr() } }
        const m    = match e { EMethodCall(r,m,ma) { yield m } _ { yield "" } }
        // Check if receiver is a module alias → module-qualified function call type inference
        const recvStr = match recv { EIdent(n) { yield n } _ { yield "" } }
        // HTTP module constructors — give these concrete, distinct types so
        // downstream method dispatch (server vs client) can key off the
        // receiver's actual type instead of guessing from argument count.
        if recvStr == "http" && m == "Server" { return "HttpServer" }
        if recvStr == "http" && m == "Client" { return "HttpClient" }
        // compiler.fnDefParams(...)'s declared return type (Array<Param>)
        // isn't reliably resolved through the generic __fn__ scope lookup
        // below, so origParams[0].name (indexing then field access) was
        // falling back to an untyped void* element and failing to compile
        // ("member reference base type 'void'"). Give it explicitly.
        if recvStr == "compiler" && m == "fnDefParams" { return "Array<compiler.Param>" }
        if string_length(recvStr) > 0 {
            const modName = scopeLookup(sc, "__mod__" + recvStr)
            if string_length(modName) > 0 {
                const qualName = modName + "__" + m
                const retTy = scopeLookup(sc, "__fn__" + qualName)
                if string_length(retTy) > 0 { return retTy }
            }
        }
        // Known methods that return non-void*
        if m == "length"    { return "int" }
        if m == "substring" { return "string" }
        if m == "contains"  { return "bool" }
        if m == "toUpper"   { return "string" }
        if m == "toLower"   { return "string" }
        if m == "trim"      { return "string" }
        // Sequential concurrency shims: a Chan is a FIFO and a TaskGroup is a
        // list of already-computed results, so their element types come
        // straight from the receiver's type argument.
        const cRecvTy = inferExprTy(recv, sc, sym)
        if string_length(cRecvTy) > 5 && cRecvTy.substring(0, 5) == "Chan<" {
            const chElem = cRecvTy.substring(5, string_length(cRecvTy) - 1)
            if m == "receive" { return chElem }
            if m == "send"    { return "void" }
        }
        if string_length(cRecvTy) > 10 && cRecvTy.substring(0, 10) == "TaskGroup<" {
            const tgElem = cRecvTy.substring(10, string_length(cRecvTy) - 1)
            if m == "waitAll" { return "Array<" + tgElem + ">" }
            if m == "add"     { return "void" }
        }
        // Class method: resolve through the receiver's own type so chains like
        // b.add("x").add("y") know that add() hands back a Builder.
        const mRecvTy = inferExprTy(recv, sc, sym)
        // HTTP client responses: client.get(url) / client.post(url, body) → HttpResponse
        if mRecvTy == "HttpClient" && (m == "get" || m == "post") { return "HttpResponse" }
        // server.listen_background() returns the bound port as an int (was
        // falling through to void*, breaking int_to_string(port) downstream).
        if mRecvTy == "HttpServer" && m == "listen_background" { return "int" }
        let mClass = mRecvTy
        const mcLen = string_length(mClass)
        if mcLen > 1 && mClass.substring(mcLen - 1, mcLen) == "?" { mClass = mClass.substring(0, mcLen - 1) }
        if string_length(mClass) > 0 && mClass != "void" && mClass != "void*"
            && mClass != "int" && mClass != "bool" && mClass != "float" && mClass != "string" {
            const mRet = scopeLookup(sc, "__fn__" + mClass + "__" + m)
            if string_length(mRet) > 0 { return mRet }
        }
        return "void*"
    }

    if tag == "index" {
        // Try to infer element type from array type
        const arrExpr = match e { EIndex(a, idx) { yield a } _ { yield compiler.nullExpr() } }
        const arrTy = inferExprTy(arrExpr, sc, sym)
        if string_length(arrTy) > 6 && arrTy.substring(0, 6) == "Array<" {
            return arrTy.substring(6, string_length(arrTy) - 1)
        }
        return "void*"
    }
    if tag == "array" {
        // Try to infer element type from first element of array literal
        const elems = match e { EArray(elems) { yield elems } _ { yield compiler.emptyExprs() } }
        if elems.length > 0 {
            const elemTy = inferExprTy(elems[0], sc, sym)
            if string_length(elemTy) > 0 && elemTy != "void*" {
                return "Array<" + elemTy + ">"
            }
        }
        return "void*"
    }
    if tag == "async" { return "void*" }

    if tag == "if" {
        const th = match e { EIf(c, th, el) { yield th } _ { yield compiler.emptyStmts() } }
        // Type is the type of the then-branch's last expression (yield value)
        if th.length > 0 {
            const last = th[th.length - 1]
            const lastTy = inferStmtYieldTy(last, sc, sym)
            if string_length(lastTy) > 0 { return lastTy }
        }
        return "void*"
    }

    if tag == "match" {
        // Type is the type of the first arm's yield value
        const arms = match e { EMatch(s, arms) { yield arms } _ { yield compiler.emptyArms() } }
        if arms.length > 0 {
            const firstArm = arms[0]
            const armTy = inferMatchArmTy(firstArm, sc, sym)
            if string_length(armTy) > 0 { return armTy }
        }
        return "void*"
    }

    if tag == "block" {
        const stmts = match e { EBlock(stmts) { yield stmts } _ { yield compiler.emptyStmts() } }
        if stmts.length > 0 {
            const last = stmts[stmts.length - 1]
            const lastTy = inferStmtYieldTy(last, sc, sym)
            if string_length(lastTy) > 0 { return lastTy }
        }
        return "void*"
    }

    return "void*"
}

fn inferStmtYieldTy(stmt: compiler.Stmt, sc: Scope, sym: typeck.SymTable) -> string {
    const tag = match stmt {
        SLet(isMut, name, init) { yield "let" }
        SReturn(vals)           { yield "return" }
        SYield(e)               { yield "yield" }
        SExpr(e)                { yield "expr" }
        _                       { yield "other" }
    }
    if tag == "yield" {
        const e = match stmt { SYield(e) { yield e } _ { yield compiler.nullExpr() } }
        return inferExprTy(e, sc, sym)
    }
    if tag == "expr" {
        const e = match stmt { SExpr(e) { yield e } _ { yield compiler.nullExpr() } }
        return inferExprTy(e, sc, sym)
    }
    return ""
}

fn inferMatchArmTy(arm: compiler.MatchArm, sc: Scope, sym: typeck.SymTable) -> string {
    if arm.body.length > 0 {
        const last = arm.body[arm.body.length - 1]
        return inferStmtYieldTy(last, sc, sym)
    }
    return ""
}

// ── Build TypedExpr ────────────────────────────────────────────────────────────

fn makeTyped(e: compiler.Expr, sc: Scope, sym: typeck.SymTable) -> TypedExpr {
    const ty = inferExprTy(e, sc, sym)
    return TypedExpr(kind: e, ty: ty)
}

// ── Scope population from function parameters ─────────────────────────────────

fn populateScopeFromParams(sc: Scope, params: Array<compiler.Param>) {
    for p in params {
        // Map Haki type strings to our simplified type tags
        const ty = simplifyTy(p.ty)
        scopeSet(sc, p.name, ty)
    }
}

fn simplifyTy(ty: string) -> string {
    if ty == "int"    { return "int" }
    if ty == "float"  { return "float" }
    if ty == "bool"   { return "bool" }
    if ty == "string" { return "string" }
    if ty == "void"   { return "void" }
    // Array and Map types: preserve the full type string so element types can be extracted later.
    // (cTy will still map these to void* for C emission purposes.)
    if string_length(ty) > 5 && ty.substring(0, 5) == "Array" { return ty }
    if string_length(ty) > 3 && ty.substring(0, 3) == "Map"   { return ty }
    // Optional types → void*
    const n = string_length(ty)
    if n > 1 && ty.substring(n - 1, n) == "?" { return "void*" }
    // Named types (structs, etc.) → preserve for struct type inference
    return ty
}

// ── Walk a function body and annotate let bindings in scope ───────────────────

fn inferFnScope(stmts: Array<compiler.Stmt>, sc: Scope, sym: typeck.SymTable) {
    for stmt in stmts {
        const tag = match stmt {
            SLet(isMut, name, init) { yield "let" }
            SIf(c, th, el)          { yield "if" }
            SWhile(cond, body)      { yield "while" }
            SFor(v, iter, body)     { yield "for" }
            SBlock(blk)             { yield "block" }
            _                       { yield "other" }
        }
        if tag == "let" {
            const name = match stmt { SLet(isMut, name, init) { yield name } _ { yield "" } }
            const init = match stmt { SLet(isMut, name, init) { yield init } _ { yield compiler.nullExpr() } }
            const ty = inferExprTy(init, sc, sym)
            scopeSet(sc, name, ty)
        }
        if tag == "if" {
            const th = match stmt { SIf(c, th, el) { yield th } _ { yield compiler.emptyStmts() } }
            const el = match stmt { SIf(c, th, el) { yield el } _ { yield compiler.emptyStmts() } }
            inferFnScope(th, sc, sym)
            inferFnScope(el, sc, sym)
        }
        if tag == "while" {
            const body = match stmt { SWhile(cond, body) { yield body } _ { yield compiler.emptyStmts() } }
            inferFnScope(body, sc, sym)
        }
        if tag == "for" {
            const v    = match stmt { SFor(v, iter, body) { yield v }    _ { yield "" } }
            const iter = match stmt { SFor(v, iter, body) { yield iter } _ { yield compiler.nullExpr() } }
            const body = match stmt { SFor(v, iter, body) { yield body } _ { yield compiler.emptyStmts() } }
            // Try to infer element type from the iterator's array type
            const iterTy = inferExprTy(iter, sc, sym)
            let elemTy = "void*"
            if string_length(iterTy) > 6 && iterTy.substring(0, 6) == "Array<" {
                const inner = iterTy.substring(6, string_length(iterTy) - 1)
                if string_length(inner) > 0 { elemTy = inner }
            }
            scopeSet(sc, v, elemTy)
            inferFnScope(body, sc, sym)
        }
        if tag == "block" {
            const blk = match stmt { SBlock(blk) { yield blk } _ { yield compiler.emptyStmts() } }
            inferFnScope(blk, sc, sym)
        }
    }
}

// ── Public API ────────────────────────────────────────────────────────────────

/// Look up the inferred type of an expression in the context of a function.
/// This is the main entry point for the cemit layer.
fn inferExpr(e: compiler.Expr, fnDef: compiler.FnDef, sym: typeck.SymTable) -> TypedExpr {
    const sc = scopeNew()
    populateScopeFromParams(sc, fnDef.params)
    inferFnScope(fnDef.body, sc, sym)
    return makeTyped(e, sc, sym)
}

/// Infer type of every expression in a function body, return scope.
/// Used by the cemit to get a scope map for a function before emitting.
fn buildFnScope(fnDef: compiler.FnDef, sym: typeck.SymTable) -> Scope {
    const sc = scopeNew()
    populateScopeFromParams(sc, fnDef.params)
    inferFnScope(fnDef.body, sc, sym)
    return sc
}

/// Infer the type of a single expression given a pre-built scope.
fn inferWithScope(e: compiler.Expr, sc: Scope, sym: typeck.SymTable) -> string {
    return inferExprTy(e, sc, sym)
}
