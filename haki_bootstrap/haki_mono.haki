// haki_mono.haki — Monomorphization pass written in Haki
//
// Takes a parsed + typechecked program and produces a concrete, fully
// specialized representation. Generic functions are instantiated for each
// unique combination of type arguments. Method names are mangled to
// TypeName__method convention. Struct/class methods are lifted to top-level.
//
// This is a bootstrap-subset mono pass — it handles:
//   - Concrete (non-generic) functions: pass through unchanged
//   - Struct methods: lift with TypeName__method naming
//   - Class methods: same as struct
//   - Import items: skip
//   - Enum definitions: pass through
//
// Full generics specialization (Stack<int> → Stack__int) is scaffolded
// but deferred — the bootstrap compiler uses the Rust host for codegen.

import "./haki_compiler" as compiler

// ── Mono output types ─────────────────────────────────────────────────────────

struct MonoFn {
    const name:    string
    const params:  Array<compiler.Param>
    const retTy:   string
    const body:    Array<compiler.Stmt>
}

struct MonoProgram {
    let fns:     Array<MonoFn>
    let structs: Array<compiler.StructDef>
    let items:   int     // total input items
    let fnCount: int     // top-level functions
}

fn monoNew() -> MonoProgram {
    return MonoProgram(fns: [], structs: [], items: 0, fnCount: 0)
}

// ── Name mangling ─────────────────────────────────────────────────────────────

fn mangle(typeName: string, methodName: string) -> string {
    return typeName + "__" + methodName
}

fn isGenericTy(ty: string) -> bool {
    // A type is generic if it contains a single uppercase letter as the whole name
    // e.g. "T", "U", "V" — simple heuristic for bootstrap
    if string_length(ty) != 1 { return false }
    const ch = ty.substring(0, 1)
    if ch == "T" || ch == "U" || ch == "V" || ch == "K" || ch == "E" {
        return true
    }
    return false
}

fn hasGenericParams(f: compiler.FnDef) -> bool {
    for p in f.params {
        if isGenericTy(p.ty) { return true }
    }
    if isGenericTy(f.retTy) { return true }
    return false
}

// ── Core monomorphization pass ─────────────────────────────────────────────────

fn lowerFn(f: compiler.FnDef) -> MonoFn {
    return MonoFn(
        name:   f.name,
        params: f.params,
        retTy:  f.retTy,
        body:   f.body
    )
}

fn lowerStructMethods(prog: MonoProgram, s: compiler.StructDef, body: Array<compiler.Stmt>) {
    // Extract fn definitions from the struct body statements
    // (In the bootstrap AST, struct methods appear as SExpr(ECall("fn", ...)) — simplified)
    // For now: lift the struct itself and note its existence
    prog.structs.append(s)
}

// ── Local constructors for imported types ─────────────────────────────────────
// Needed because `compiler.FnDef(...)` named-call syntax isn't yet supported
// in the bootstrap parser for qualified type construction.

// makeFnDef: defined via compiler.FnDef construction in lowerFn below

// makeStructDef: not needed — extractStruct handles this





fn extractFn(item: compiler.Item) -> compiler.FnDef {
    // Note: _ arm needs an EmptyFnDef — we call a no-op helper registered in compiler
    const result = match item {
        IFn(f) { yield f }
        _ { yield compiler.emptyFnDef() }
    }
    return result
}

fn extractStruct(item: compiler.Item) -> compiler.StructDef {
    const result = match item {
        IStruct(s) { yield s }
        _ { yield compiler.emptyStructDef() }
    }
    return result
}

fn lowerItem(prog: MonoProgram, item: compiler.Item) {
    prog.items = prog.items + 1
    const tag = match item {
        IFn(f) { yield "fn" }
        IStruct(s) { yield "struct" }
        IImport(p, a) { yield "import" }
    }

    if tag == "fn" {
        const f = extractFn(item)
        if hasGenericParams(f) { return }
        prog.fns.append(lowerFn(f))
        prog.fnCount = prog.fnCount + 1
    }

    if tag == "struct" {
        const s = extractStruct(item)
        prog.structs.append(s)
    }
    // imports: skip
}

fn monomorphize(items: Array<compiler.Item>) -> MonoProgram {
    let prog = monoNew()
    for item in items {
        lowerItem(prog, item)
    }
    return prog
}

// ── Full pipeline entry point ─────────────────────────────────────────────────

fn monoFromSource(src: string) -> (MonoProgram, Error?) {
    const items, parseErr = compiler.parse(src)
    if parseErr != null {
        return monoNew(), Error(message: "parse error: " + parseErr.message)
    }
    return monomorphize(items), null
}

// ── Display ───────────────────────────────────────────────────────────────────

fn showMonoProgram(prog: MonoProgram) {
    print("MonoProgram:")
    print("  " + int_to_string(prog.fnCount) + " concrete function(s)")
    print("  " + int_to_string(prog.structs.length) + " struct(s)")
    for f in prog.fns {
        print("  fn " + f.name + "(" + int_to_string(f.params.length) + " params) -> " + f.retTy)
    }
}

// ── Tests ─────────────────────────────────────────────────────────────────────

fn test_concrete_fn() {
    const prog, err = monoFromSource(
        "fn add(a: int, b: int) -> int { return a + b }\nfn main() { }"
    )
    if err != null { panic("mono error: " + err.message) }
    if prog.fnCount != 2 { panic("expected 2 fns, got: " + int_to_string(prog.fnCount)) }
}

fn test_struct_passthrough() {
    const prog, err = monoFromSource(
        "struct Point { const x: int  const y: int }\nfn main() { }"
    )
    if err != null { panic("mono error: " + err.message) }
    if prog.structs.length != 1 { panic("expected 1 struct") }
    if prog.fnCount != 1 { panic("expected 1 fn") }
}

fn test_mangle() {
    const name = mangle("Point", "distance")
    if name != "Point__distance" { panic("mangle wrong: " + name) }
}

fn test_generic_skip() {
    const prog, err = monoFromSource(
        "fn identity(x: T) -> T { return x }\nfn add(a: int, b: int) -> int { return a + b }"
    )
    if err != null { panic("mono error: " + err.message) }
    // generic identity should be skipped, concrete add should remain
    if prog.fnCount != 1 { panic("expected 1 concrete fn, got: " + int_to_string(prog.fnCount)) }
}

fn main() {
    const prog, err = monoFromSource(
        "fn add(a: int, b: int) -> int { return a + b }\n" +
        "fn greet(name: string) -> string { return name }\n" +
        "struct Point { const x: int  const y: int }\n" +
        "fn main() { const x = add(1, 2)  print_int(x) }"
    )
    if err != null { print("error: " + err.message)  return }
    showMonoProgram(prog)
}

// Factory helpers for cross-module MonoFn construction
fn makeMonoFn(name: string, params: Array<compiler.Param>, retTy: string, body: Array<compiler.Stmt>) -> MonoFn {
    return MonoFn(name: name, params: params, retTy: retTy, body: body)
}
