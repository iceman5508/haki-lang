// hakic.haki — Haki compiler driver (bootstrap-compatible, v2.0)
//
// Bootstrap-restricted Haki: no multi-return destructuring, no qualified calls.
// Import resolution: recursively reads and merges all imported modules.

import "./haki_compiler" as compiler
import "./haki_typeck"   as typeck
import "./haki_mono"     as mono
import "./haki_cemit"    as cemit

fn printUsage() {
    print("usage: hakic <source.haki>")
    print("       hakic check <source.haki>")
    print("       hakic <source.haki> --emit-c -o <output>")
}

fn doCheck(path: string) {
    const src, _readErr = readFile(path)
    const items, _pe1 = compiler__parse(src)
    const sym, _te1 = typeck__typecheck(src)
    print("✓  " + path)
}

// Resolve all imports in an items list, merging their MonoPrograms into dst.
// Each IImport(path, alias) is processed: parse the file, monomorphize it,
// merge with alias__ prefix so call sites match.
fn alreadyResolved(visited: Array<string>, path: string) -> bool {
    for p in visited {
        if p == path { return true }
    }
    return false
}

fn resolveImports(dst: mono.MonoProgram, items: Array<compiler.Item>, visited: Array<string>) {
    let i = 0
    while i < items.length {
        const item = items[i]
        const isImport = match item {
            IImport(p, a) { yield true }
            _ { yield false }
        }
        if isImport {
            const path  = match item { IImport(p, a) { yield p } _ { yield "" } }
            const alias = match item { IImport(p, a) { yield a } _ { yield "" } }
            if path != "__skip__" {
                const fullPath = path + ".haki"
                if !alreadyResolved(visited, fullPath) {
                    visited.append(fullPath)
                    const modSrc, _modErr2 = readFile(fullPath)
                    const modItems, _pe2 = compiler__parse(modSrc)
                    const modProg = mono__monomorphize(modItems)
                    mono__mergeProgramWithAlias(dst, modProg, alias)
                    resolveImports(dst, modItems, visited)
                }
            }
        }
        i = i + 1
    }
}

fn doEmitC(srcPath: string, outPath: string) {
    const src, _srcErr = readFile(srcPath)
    const items, _pe3 = compiler__parse(src)
    const rtSrc, _rtErr = readFile("./haki_runtime_core.c")

    // Resolve all imports into the monomorphized program before emitting.
    const prog = mono__monomorphize(items)
    let visited = [srcPath]
    resolveImports(prog, items, visited)

    const cSrc = cemit__emitProgram(prog, rtSrc)

    const _wErr = writeFile(outPath, cSrc)
    print("[emit-c]  " + outPath + " (" + int_to_string(string_length(cSrc)) + " bytes)")
}

fn main() {
    const args = argv()

    if args.length < 2 {
        printUsage()
        return
    }

    const cmd = args[1]

    if cmd == "check" {
        if args.length < 3 {
            print("hakic check: missing source file")
            return
        }
        doCheck(args[2])
        return
    }

    let srcPath = ""
    let outPath = ""
    let doEmit = false
    let i = 1
    while i < args.length {
        const a = args[i]
        if a == "--emit-c" {
            doEmit = true
        } else if a == "-o" {
            i = i + 1
            if i < args.length { outPath = args[i] }
        } else if a != "--quiet" {
            if string_length(srcPath) == 0 { srcPath = a }
        }
        i = i + 1
    }

    if string_length(srcPath) == 0 {
        printUsage()
        return
    }

    if doEmit {
        if string_length(outPath) == 0 { outPath = srcPath + ".c" }
        doEmitC(srcPath, outPath)
        return
    }

    const src, _mainErr = readFile(srcPath)
    print("[lex+parse]")
    const items, _pe4 = compiler__parse(src)
    print("[typecheck]")
    const sym, _te4 = typeck__typecheck(src)
    print("")
    print("✓  ok")
}
