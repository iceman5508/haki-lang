// haki_cemit.haki — C code emitter written in Haki
//
// Takes a mono.MonoProgram (from haki_mono.haki) and emits a complete, self-contained
// C source file that compiles with: gcc -std=gnu11 -O2 -lpthread -lm -o out out.c
//
// This closes the bootstrap loop: the Haki compiler can now lower its own source
// all the way to C without touching the Rust host compiler.

import "./haki_mono"       as mono
import "./haki_compiler"   as compiler
import "./haki_typeck"     as typeck
import "./haki_typeinfer"  as tinfer

// ── C name mangling ────────────────────────────────────────────────────────────

fn cName(name: string) -> string {
    // Replace :: with __ (module paths)
    // Reserve C keywords
    if name == "int"      { return "haki_int" }
    if name == "float"    { return "haki_float" }
    if name == "double"   { return "haki_double" }
    if name == "char"     { return "haki_char" }
    if name == "return"   { return "haki_return" }
    if name == "void"     { return "haki_void" }
    if name == "struct"   { return "haki_struct" }
    if name == "typedef"  { return "haki_typedef" }
    if name == "static"   { return "haki_static" }
    if name == "extern"   { return "haki_extern" }
    if name == "switch"   { return "haki_switch" }
    if name == "case"     { return "haki_case" }
    if name == "default"  { return "haki_default" }
    if name == "enum"     { return "haki_enum" }
    return name
}

// ── Type mapping ───────────────────────────────────────────────────────────────

fn cTy(ty: string) -> string {
    if ty == "int"    { return "int64_t" }
    if ty == "float"  { return "double" }
    if ty == "bool"   { return "int8_t" }
    if ty == "string" { return "const char*" }
    if ty == "void"   { return "void" }
    if ty == ""       { return "void" }
    // Already-opaque pointer — don't double-pointer it
    if ty == "void*"  { return "void*" }
    // Error and nullable types → void*
    if ty == "Error"  { return "void*" }
    if ty == "Error?" { return "void*" }
    // Optional types → pointer to inner
    const n = string_length(ty)
    if n > 1 && ty.substring(n - 1, n) == "?" {
        return "void*"   // nullable — use void*
    }
    // Generic types: Array<T>, Map<K,V>
    if string_length(ty) > 5 && ty.substring(0, 5) == "Array" { return "void*" }
    if string_length(ty) > 3 && ty.substring(0, 3) == "Map"   { return "void*" }
    if string_length(ty) > 4 && ty.substring(0, 4) == "Task"  { return "void*" }
    // Module-qualified types: module.Type → module__Type*
    // Find the dot and replace with __
    let di = 0
    while di < string_length(ty) {
        if ty.substring(di, di + 1) == "." {
            const prefix = ty.substring(0, di)
            const suffix = ty.substring(di + 1, string_length(ty))
            return prefix + "__" + suffix + "*"
        }
        di = di + 1
    }
    // Named types → pointer
    return cName(ty) + "*"
}

fn cRetTy(ty: string) -> string {
    if ty == "void" || ty == "" { return "void" }
    // Tuple return types (multi-return) → void*
    const n = string_length(ty)
    if n > 0 && ty.substring(0, 1) == "(" { return "void*" }
    return cTy(ty)
}

fn isScalarTy(ty: string) -> bool {
    return ty == "int" || ty == "float" || ty == "bool"
}

// ── Indent helper ──────────────────────────────────────────────────────────────

fn indent(depth: int) -> string {
    let s = ""
    let i = 0
    while i < depth {
        s = s + "    "
        i = i + 1
    }
    return s
}

// ── String escaping ────────────────────────────────────────────────────────────

fn escapeStr(s: string) -> string {
    let out = ""
    let i = 0
    const n = string_length(s)
    while i < n {
        const ch = s.substring(i, i + 1)
        if ch == "\"" { out = out + "\\\"" }
        else if ch == "\\" { out = out + "\\\\" }
        else if ch == "\n" { out = out + "\\n" }
        else if ch == "\t" { out = out + "\\t" }
        else { out = out + ch }
        i = i + 1
    }
    return out
}

// ── Helper: parse comma-separated field name at index ─────────────────────────

fn getFieldAt(fields: string, idx: int) -> string {
    let start = 0
    let fi = 0
    const n = string_length(fields)
    while start < n {
        let end = start
        while end < n && fields.substring(end, end + 1) != "," {
            end = end + 1
        }
        if fi == idx { return fields.substring(start, end) }
        fi = fi + 1
        start = end + 1
    }
    return "f" + int_to_string(idx)  // fallback
}

// getTypeAt: extract the idx-th semicolon-separated type from a "__vt__" string
// e.g. getTypeAt("bool;string;Expr", 1) → "string"
fn getTypeAt(types: string, idx: int) -> string {
    let start = 0
    let ti = 0
    const n = string_length(types)
    while start <= n {
        let end = start
        while end < n && types.substring(end, end + 1) != ";" {
            end = end + 1
        }
        if ti == idx { return types.substring(start, end) }
        ti = ti + 1
        start = end + 1
        if end >= n { return "" }
    }
    return ""
}

// ── Expression emission ────────────────────────────────────────────────────────

fn emitExpr(e: compiler.Expr, depth: int, sc: tinfer.Scope, sym: typeck.SymTable) -> string {
    const tag = match e {
        EInt(n)             { yield "int" }
        EBool(b)            { yield "bool" }
        ENull               { yield "null" }
        EString(s)          { yield "string" }
        EFStr(segs)         { yield "fstr" }
        ETry(inner)         { yield "try" }
        ENamedCall(n, args) { yield "namedcall" }
        EIdent(n)           { yield "ident" }
        EUnary(op, inner)   { yield "unary" }
        EBinary(op, l, r)   { yield "binary" }
        ECall(n, args)      { yield "call" }
        EField(recv, f)     { yield "field" }
        EMethodCall(r,m,ma) { yield "method" }
        EIndex(a, idx)      { yield "index" }
        EArray(elems)       { yield "array" }
        EIf(c, th, el)      { yield "if" }
        EMatch(s, arms)     { yield "match" }
        EBlock(stmts)       { yield "block" }
        EAsync(inner)       { yield "async" }
    }

    if tag == "int" {
        const n = match e { EInt(n) { yield n } _ { yield 0 } }
        return "((int64_t)" + int_to_string(n) + "LL)"
    }
    if tag == "bool" {
        const b = match e { EBool(b) { yield b } _ { yield false } }
        if b { return "1" }
        return "0"
    }
    if tag == "null"   { return "NULL" }
    if tag == "string" {
        // f-string: emit as haki_string_concat chain
        if tag == "fstr" {
            const segs = match e { EFStr(segs) { yield segs } _ { yield compiler.emptyExprs() } }
            if segs.length == 0 { return "\"\"" }
            let r = emitExpr(segs[0], depth, sc, sym)
            let i = 1
            while i < segs.length {
                r = "haki_string_concat(" + r + ", " + emitExpr(segs[i], depth, sc, sym) + ")"
                i = i + 1
            }
            return r
        }
        // try desugaring: emitted as __try_val from desugar (handled by compiler driver)
        if tag == "try" {
            const inner = match e { ETry(inner) { yield inner } _ { yield compiler.nullExpr() } }
            return emitExpr(inner, depth, sc, sym)
        }
        const s = match e { EString(s) { yield s } _ { yield "" } }
        return "\"" + escapeStr(s) + "\""
    }
    if tag == "ident" {
        const n = match e { EIdent(n) { yield n } _ { yield "" } }
        // Check if this is a unit enum variant (discriminant stored in meta-scope)
        const discStr = tinfer.scopeLookup(sc, "__v__" + n)
        if string_length(discStr) > 0 {
            return "({ void* __ev = malloc(sizeof(void*)*2); ((int64_t*)__ev)[0] = " + discStr + "LL; ((void**)__ev)[1] = NULL; __ev; })"
        }
        return cName(n)
    }

    if tag == "namedcall" {
        const ncn = match e { ENamedCall(n, args) { yield n } _ { yield "" } }
        const ncargs = match e { ENamedCall(n, args) { yield args } _ { yield compiler.emptyExprs() } }
        const cncn = cName(ncn)
        // Look up struct field names from meta-scope
        const fieldsStr = tinfer.scopeLookup(sc, "__sf__" + ncn)
        if string_length(fieldsStr) == 0 {
            // Also try without module prefix (strip "module__" if present)
            // Fallback: emit as malloc + field assignments using positional args
            let ns = "({ " + cncn + "* __c_" + cncn + " = (" + cncn + "*)malloc(sizeof(" + cncn + ")); "
            let ai = 0
            while ai < ncargs.length {
                ns = ns + "__c_" + cncn + "->f" + int_to_string(ai) + " = " + emitExpr(ncargs[ai], depth, sc, sym) + "; "
                ai = ai + 1
            }
            ns = ns + "__c_" + cncn + "; })"
            return ns
        }
        // Emit struct constructor using named fields
        let ns = "({ " + cncn + "* __c_" + cncn + " = (" + cncn + "*)malloc(sizeof(" + cncn + ")); "
        let ai = 0
        while ai < ncargs.length {
            const fname = getFieldAt(fieldsStr, ai)
            ns = ns + "__c_" + cncn + "->" + fname + " = " + emitExpr(ncargs[ai], depth, sc, sym) + "; "
            ai = ai + 1
        }
        ns = ns + "__c_" + cncn + "; })"
        return ns
    }
    if tag == "unary" {
        const op = match e { EUnary(op, inner) { yield op } _ { yield "" } }
        const inner = match e { EUnary(op, inner) { yield inner } _ { yield compiler.nullExpr() } }
        return "(" + op + emitExpr(inner, depth, sc, sym) + ")"
    }
    if tag == "binary" {
        const op = match e { EBinary(op, l, r) { yield op } _ { yield "" } }
        const lExpr = match e { EBinary(op, l, r) { yield l } _ { yield compiler.nullExpr() } }
        const rExpr = match e { EBinary(op, l, r) { yield r } _ { yield compiler.nullExpr() } }
        const le = emitExpr(lExpr, depth, sc, sym)
        const re = emitExpr(rExpr, depth, sc, sym)
        // If either side is an integer literal, force arithmetic ops (avoids string_concat on mistyped fields)
        const lIsEInt = match lExpr { EInt(n) { yield true } _ { yield false } }
        const rIsEInt = match rExpr { EInt(n) { yield true } _ { yield false } }
        if (lIsEInt || rIsEInt) && (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") {
            return "(" + le + " " + op + " " + re + ")"
        }
        if (lIsEInt || rIsEInt) && (op == "<" || op == ">" || op == "<=" || op == ">=" || op == "==" || op == "!=") {
            return "(" + le + " " + op + " " + re + ")"
        }
        // Use type inference to pick the right C operator
        const lty = tinfer.inferWithScope(lExpr, sc, sym)
        const rty = tinfer.inferWithScope(rExpr, sc, sym)
        // If either side is a string literal or string type, force string comparison
        const lIsStr = match lExpr { EString(s) { yield true } _ { yield false } }
        const rIsStr = match rExpr { EString(s) { yield true } _ { yield false } }
        let effectiveLty = lty
        if (lIsStr || rIsStr || rty == "string") && lty == "void*" { effectiveLty = "string" }
        const cop = tinfer.binaryOpC(op, effectiveLty)

        if cop == "string_concat" {
            return "haki_string_concat(" + le + ", " + re + ")"
        }
        if cop == "string_eq" {
            return "(strcmp(" + le + ", " + re + ") == 0)"
        }
        if cop == "string_neq" {
            return "(strcmp(" + le + ", " + re + ") != 0)"
        }
        if cop == "ptr_eq" {
            return "(" + le + " == " + re + ")"
        }
        if cop == "ptr_neq" {
            return "(" + le + " != " + re + ")"
        }
        return "(" + le + " " + cop + " " + re + ")"
    }
    if tag == "call" {
        const n = match e { ECall(n, args) { yield n } _ { yield "" } }
        const args = match e { ECall(n, args) { yield args } _ { yield compiler.emptyExprs() } }
        return emitCall(n, args, depth, sc, sym)
    }
    if tag == "field" {
        const recv = match e { EField(recv, f) { yield recv } _ { yield compiler.nullExpr() } }
        const f = match e { EField(recv, f) { yield f } _ { yield "" } }
        // Error field access
        if f == "message" { return "haki_error_message(" + emitExpr(recv, depth, sc, sym) + ")" }
        if f == "cause"   { return "haki_error_cause(" + emitExpr(recv, depth, sc, sym) + ")" }
        if f == "length"  { return "haki_array_length(" + emitExpr(recv, depth, sc, sym) + ")" }
        return emitExpr(recv, depth, sc, sym) + "->" + cName(f)
    }
    if tag == "method" {
        const recv = match e { EMethodCall(r,m,ma) { yield r } _ { yield compiler.nullExpr() } }
        const m = match e { EMethodCall(r,m,ma) { yield m } _ { yield "" } }
        const args = match e { EMethodCall(r,m,ma) { yield ma } _ { yield compiler.emptyExprs() } }
        // Module-qualified calls: module.method(args) → module__method(args)
        // Detect when receiver is a module alias identifier
        const recvIsIdent = match recv { EIdent(rn) { yield true } _ { yield false } }
        if recvIsIdent {
            const rn = match recv { EIdent(rn) { yield rn } _ { yield "" } }
            if rn == "compiler" || rn == "typeck" || rn == "mono" || rn == "cemit" || rn == "tinfer" || rn == "lex" {
                return rn + "__" + cName(m) + "(" + emitExprList(args, depth, sc, sym) + ")"
            }
        }
        const re = emitExpr(recv, depth, sc, sym)
        if m == "append" && args.length == 1 {
            const av = emitExpr(args[0], depth, sc, sym)
            return "({ void* __el = " + av + "; haki_array_append(" + re + ", &__el); })"
        }
        if m == "length"  { return "haki_array_length(" + re + ")" }
        if m == "has"     { return "haki_map_has(" + re + ", " + emitExprList(args, depth, sc, sym) + ")" }
        if m == "get"     { return "haki_map_get(" + re + ", " + emitExprList(args, depth, sc, sym) + ")" }
        if m == "set"     { return "haki_map_set(" + re + ", " + emitExprList(args, depth, sc, sym) + ")" }
        if m == "getOrDefault" && args.length == 2 {
            return "haki_map_get_or_default(" + re + ", " + emitExpr(args[0], depth, sc, sym) + ", " + emitExpr(args[1], depth, sc, sym) + ")"
        }
        if m == "substring" {
            return "haki_string_substring(" + re + ", " + emitExprList(args, depth, sc, sym) + ")"
        }
        if m == "contains" {
            return "haki_string_contains(" + re + ", " + emitExprList(args, depth, sc, sym) + ")"
        }
        if m == "split"   { return "haki_string_split(" + re + ", " + emitExprList(args, depth, sc, sym) + ")" }
        if m == "toUpper" { return "haki_string_to_upper(" + re + ")" }
        if m == "toLower" { return "haki_string_to_lower(" + re + ")" }
        if m == "trim"    { return "haki_string_trim(" + re + ")" }
        // Generic method call
        let argStr = ""
        if args.length > 0 { argStr = ", " + emitExprList(args, depth, sc, sym) }
        return re + "->" + cName(m) + "(" + re + argStr + ")"
    }
    if tag == "index" {
        const arr = match e { EIndex(a, idx) { yield a } _ { yield compiler.nullExpr() } }
        const idx = match e { EIndex(a, idx) { yield idx } _ { yield compiler.nullExpr() } }
        const arrC = emitExpr(arr, depth, sc, sym)
        const idxC = emitExpr(idx, depth, sc, sym)
        // If we know the element type from Array<T>, emit a cast for struct elements
        const arrTy = tinfer.inferWithScope(arr, sc, sym)
        if string_length(arrTy) > 6 && arrTy.substring(0, 6) == "Array<" {
            const inner = arrTy.substring(6, string_length(arrTy) - 1)
            // Don't cast primitives — they have their own boxed unboxing
            const innerIsStr  = inner == "string"
            const innerIsInt  = inner == "int"
            const innerIsBool = inner == "bool"
            if !innerIsStr && !innerIsInt && !innerIsBool {
                const cElemTy = cTy(inner)
                if isSimpleCType(cElemTy) && cElemTy != "void*" {
                    return "((" + cElemTy + ")(*((void**)haki_array_get(" + arrC + ", " + idxC + "))))"
                }
            }
        }
        return "(*((void**)haki_array_get(" + arrC + ", " + idxC + ")))"
    }
    if tag == "array" {
        // Emit inline compound statement: create array and append each element
        const elems = match e { EArray(elems) { yield elems } _ { yield compiler.emptyExprs() } }
        if elems.length == 0 {
            return "haki_array_new(sizeof(void*))"
        }
        let s = "({ void* __ial = haki_array_new(sizeof(void*)); "
        let ei = 0
        while ei < elems.length {
            const ev = emitExpr(elems[ei], depth, sc, sym)
            s = s + "{ void* __el = (void*)(" + ev + "); haki_array_append(__ial, &__el); } "
            ei = ei + 1
        }
        s = s + "__ial; })"
        return s
    }
    if tag == "if" {
        const cond = match e { EIf(c, th, el) { yield c } _ { yield compiler.nullExpr() } }
        const then = match e { EIf(c, th, el) { yield th } _ { yield compiler.emptyStmts() } }
        const els  = match e { EIf(c, th, el) { yield el } _ { yield compiler.emptyStmts() } }
        const ce = emitExpr(cond, depth, sc, sym)
        const tv = yieldVal(then, depth, sc, sym)
        const ev = yieldVal(els, depth, sc, sym)
        if string_length(tv) > 0 && string_length(ev) > 0 {
            return "((" + ce + ") ? (" + tv + ") : (" + ev + "))"
        }
        return ce
    }
    if tag == "match" {
        const scrut = match e { EMatch(s, arms) { yield s } _ { yield compiler.nullExpr() } }
        const arms  = match e { EMatch(s, arms) { yield arms } _ { yield compiler.emptyArms() } }
        return emitMatchExpr(scrut, arms, depth, sc, sym)
    }
    if tag == "block" {
        const stmts = match e { EBlock(stmts) { yield stmts } _ { yield compiler.emptyStmts() } }
        const yv = yieldVal(stmts, depth, sc, sym)
        if string_length(yv) > 0 { return "({ " + yv + "; })" }
        return "0"
    }
    if tag == "async" {
        const inner = match e { EAsync(inner) { yield inner } _ { yield compiler.nullExpr() } }
        return "haki_task_spawn_simple((void(*)(void*))" + emitExpr(inner, depth, sc, sym) + ", NULL)"
    }
    return "/* unknown expr */"
}

fn emitExprList(args: Array<compiler.Expr>, depth: int, sc: tinfer.Scope, sym: typeck.SymTable) -> string {
    let s = ""
    let i = 0
    while i < args.length {
        if i > 0 { s = s + ", " }
        s = s + emitExpr(args[i], depth, sc, sym)
        i = i + 1
    }
    return s
}

fn yieldVal(stmts: Array<compiler.Stmt>, depth: int, sc: tinfer.Scope, sym: typeck.SymTable) -> string {
    for stmt in stmts {
        const tag = match stmt {
            SYield(e) { yield "yield" }
            _ { yield "" }
        }
        if tag == "yield" {
            const e = match stmt { SYield(e) { yield e } _ { yield compiler.nullExpr() } }
            return emitExpr(e, depth, sc, sym)
        }
    }
    return ""
}

fn emitMatchExpr(scrut: compiler.Expr, arms: Array<compiler.MatchArm>, depth: int, sc: tinfer.Scope, sym: typeck.SymTable) -> string {
    const se = emitExpr(scrut, depth, sc, sym)
    let parts = "void* __msc = (void*)(" + se + "); int64_t __mtag = ((int64_t*)__msc)[0]; void* __mpayload = ((void**)__msc)[1]; "
    parts = parts + "int64_t __mr; "
    let i = 0
    while i < arms.length {
        const arm = arms[i]
        let prefix = ""
        if i == 0 { prefix = "if" } else { prefix = "} else if" }
        if arm.pattern == "_" {
            parts = parts + "} else { "
        } else {
            // Look up actual discriminant from meta-scope; fall back to arm index
            const discStr = tinfer.scopeLookup(sc, "__v__" + arm.pattern)
            let disc = int_to_string(i)
            if string_length(discStr) > 0 { disc = discStr }
            parts = parts + prefix + " (__mtag == " + disc + "LL) { "
        }
        // Bind payloads using per-slot type metadata.
        // __vt__VarName now stores ALL payload types as semicolon-separated string,
        // e.g. "bool;string;Expr" for SLet(bool, string, Expr).
        // Boxing convention in emitCall:
        //   int/bool  → boxed as int64_t*   → extract with *(int64_t*)
        //   string    → boxed as const char** → extract with *(const char**)
        //   struct/other → stored as void* directly → cast with (T*)
        let bi = 0
        while bi < arm.bindings.length {
            const biStr = int_to_string(bi)
            // Get all payload types (semicolon-separated) for this variant
            const vtAll = tinfer.scopeLookup(sc, "__vt__" + arm.pattern)
            // Get the type for this specific slot
            const slotTy = getTypeAt(vtAll, bi)

            if slotTy == "int" || slotTy == "bool" {
                // Boxed as int64_t* in emitCall — dereference to get the value
                parts = parts + "int64_t " + cName(arm.bindings[bi]) + " = *(int64_t*)((void**)__mpayload)[" + biStr + "]; "
                tinfer.scopeSet(sc, arm.bindings[bi], "int")
            } else if slotTy == "string" {
                // Boxed as const char** in emitCall — dereference to get the char*
                parts = parts + "const char* " + cName(arm.bindings[bi]) + " = *(const char**)((void**)__mpayload)[" + biStr + "]; "
                tinfer.scopeSet(sc, arm.bindings[bi], "string")
            } else {
                // Struct/generic/unknown: stored as void* directly in emitCall — direct cast
                let bindCType = "void*"
                if string_length(slotTy) > 0 {
                    // Check generic container types (Array, Map, Task) → stay void*
                    const isGenericTy = (string_length(slotTy) >= 5 && slotTy.substring(0, 5) == "Array")
                        || (string_length(slotTy) >= 3 && slotTy.substring(0, 3) == "Map")
                        || (string_length(slotTy) >= 4 && slotTy.substring(0, 4) == "Task")
                    if !isGenericTy {
                        // Strip module prefix (take suffix after last ".")
                        let baseTy = slotTy
                        let di = 0
                        while di < string_length(slotTy) {
                            if slotTy.substring(di, di + 1) == "." {
                                baseTy = slotTy.substring(di + 1, string_length(slotTy))
                            }
                            di = di + 1
                        }
                        // Strip trailing "*" if present
                        const blen = string_length(baseTy)
                        if blen > 0 && baseTy.substring(blen - 1, blen) == "*" {
                            baseTy = baseTy.substring(0, blen - 1)
                        }
                        const vtCName = cName(baseTy)
                        const vtCTy = vtCName + "*"
                        if isSimpleCType(vtCTy) { bindCType = vtCTy }
                    }
                } else if arm.bindings.length == 1 {
                    // Fallback for single-binding arms with no slot type metadata:
                    // check if the variant name is a known struct via __sf__ scope entry
                    const sfVal = tinfer.scopeLookup(sc, "__sf__" + arm.pattern)
                    if string_length(sfVal) > 0 {
                        const patCName = cName(arm.pattern)
                        const patCTy = patCName + "*"
                        if isSimpleCType(patCTy) { bindCType = patCTy }
                    }
                }
                parts = parts + bindCType + " " + cName(arm.bindings[bi]) + " = (" + bindCType + ")((void**)__mpayload)[" + biStr + "]; "
                // Update scope with binding type for subsequent type inference
                if bindCType != "void*" {
                    tinfer.scopeSet(sc, arm.bindings[bi], slotTy)
                }
            }
            bi = bi + 1
        }
        const yv = yieldVal(arm.body, depth, sc, sym)
        if string_length(yv) > 0 {
            parts = parts + "__mr = (int64_t)(" + yv + "); "
        }
        i = i + 1
    }
    parts = parts + "} __mr;"
    return "({ " + parts + "})"
}

// ── Call emission ──────────────────────────────────────────────────────────────

fn emitCall(name: string, args: Array<compiler.Expr>, depth: int, sc: tinfer.Scope, sym: typeck.SymTable) -> string {
    // Multi-return tuple unpacking: __mr_get_N(tuple) → ((void**)tuple)[N]
    if string_length(name) > 9 && name.substring(0, 9) == "__mr_get_" {
        const idxStr = name.substring(9, string_length(name))
        const av = emitExpr(args[0], depth, sc, sym)
        return "((void**)(" + av + "))[" + idxStr + "]"
    }
    // Check if this is an enum variant constructor (has payload)
    const discStr = tinfer.scopeLookup(sc, "__v__" + name)
    if string_length(discStr) > 0 {
        if args.length == 0 {
            // No-payload variant
            return "({ void* __ev = malloc(sizeof(void*)*2); ((int64_t*)__ev)[0] = " + discStr + "LL; ((void**)__ev)[1] = NULL; __ev; })"
        }
        // Build payload array boxing all args
        const safeName = cName(name)
        let payStr = "({ void** __pay_" + safeName + " = (void**)malloc(sizeof(void*) * " + int_to_string(args.length) + "); "
        let ai = 0
        while ai < args.length {
            const argC = emitExpr(args[ai], depth, sc, sym)
            const argTy = tinfer.inferWithScope(args[ai], sc, sym)
            let boxedArg = "(void*)(" + argC + ")"
            if argTy == "int" || argTy == "bool" {
                boxedArg = "({ int64_t* __pi = malloc(sizeof(int64_t)); *__pi = (int64_t)(" + argC + "); (void*)__pi; })"
            } else if argTy == "string" {
                boxedArg = "({ const char** __ps = malloc(sizeof(const char*)); *__ps = (" + argC + "); (void*)__ps; })"
            }
            payStr = payStr + "__pay_" + safeName + "[" + int_to_string(ai) + "] = " + boxedArg + "; "
            ai = ai + 1
        }
        payStr = payStr + "void* __ev = malloc(sizeof(void*)*2); ((int64_t*)__ev)[0] = " + discStr + "LL; ((void**)__ev)[1] = (void*)__pay_" + safeName + "; __ev; })"
        return payStr
    }
    // Builtin intercepts
    if name == "print" && args.length == 1 {
        return "haki_print(" + emitExpr(args[0], depth, sc, sym) + ")"
    }
    if name == "print_int" && args.length == 1 {
        return "haki_print_int(" + emitExpr(args[0], depth, sc, sym) + ")"
    }
    if name == "print_bool" && args.length == 1 {
        return "haki_print_bool(" + emitExpr(args[0], depth, sc, sym) + ")"
    }
    if name == "print_float" && args.length == 1 {
        return "haki_print_float(" + emitExpr(args[0], depth, sc, sym) + ")"
    }
    if name == "int_to_string" && args.length == 1 {
        return "haki_int_to_string(" + emitExpr(args[0], depth, sc, sym) + ")"
    }
    if name == "string_length" && args.length == 1 {
        return "haki_string_length(" + emitExpr(args[0], depth, sc, sym) + ")"
    }
    if name == "panic"    { return "haki_panic(" + emitExpr(args[0], depth, sc, sym) + ")" }
    if name == "argv"     { return "haki_argv()" }
    if name == "readFile" { return "haki_read_file(" + emitExpr(args[0], depth, sc, sym) + ")" }
    if name == "writeFile" && args.length == 2 { return "haki_write_file(" + emitExpr(args[0], depth, sc, sym) + ", " + emitExpr(args[1], depth, sc, sym) + ")" }
    if name == "fileExists" { return "haki_file_exists(" + emitExpr(args[0], depth, sc, sym) + ")" }
    if name == "Map" && args.length == 0 { return "haki_map_new(sizeof(void*))" }
    if name == "Array" && args.length == 0 { return "haki_array_new(sizeof(void*))" }
    if name == "Error"    {
        if args.length == 1 { return "haki_error_new(" + emitExpr(args[0], depth, sc, sym) + ")" }
    }
    // Array/Map methods mangled as Type__method
    if name.contains("__append") && args.length == 2 {
        const av = emitExpr(args[1], depth, sc, sym)
        return "({ void* __el = (void*)(" + av + "); haki_array_append(" + emitExpr(args[0], depth, sc, sym) + ", &__el); })"
    }
    if name.contains("__length") && args.length == 1 {
        return "haki_array_length(" + emitExpr(args[0], depth, sc, sym) + ")"
    }
    if name.contains("__has") && args.length == 2 {
        return "haki_map_has(" + emitExpr(args[0], depth, sc, sym) + ", " + emitExpr(args[1], depth, sc, sym) + ")"
    }
    if name.contains("__set") && args.length == 3 {
        return "haki_map_set(" + emitExpr(args[0], depth, sc, sym) + ", " + emitExpr(args[1], depth, sc, sym) + ", " + emitExpr(args[2], depth, sc, sym) + ")"
    }
    if name.contains("__getOrDefault") && args.length == 3 {
        return "haki_map_get_or_default(" + emitExpr(args[0], depth, sc, sym) + ", " + emitExpr(args[1], depth, sc, sym) + ", " + emitExpr(args[2], depth, sc, sym) + ")"
    }
    // Check if this is a struct constructor (positional args parsed as ECall by bootstrap parser)
    // e.g. Token(kind, lo, hi) where Token is a struct with fields "kind,lo,hi" in meta-scope
    const structFieldsStr = tinfer.scopeLookup(sc, "__sf__" + name)
    if string_length(structFieldsStr) > 0 {
        const cn = cName(name)
        let ns = "({ " + cn + "* __c_" + cn + " = (" + cn + "*)malloc(sizeof(" + cn + ")); "
        let ai = 0
        while ai < args.length {
            const fname = getFieldAt(structFieldsStr, ai)
            ns = ns + "__c_" + cn + "->" + fname + " = " + emitExpr(args[ai], depth, sc, sym) + "; "
            ai = ai + 1
        }
        ns = ns + "__c_" + cn + "; })"
        return ns
    }
    // General call — use module-qualified name if available to match forward declarations
    let argStr = ""
    let i = 0
    while i < args.length {
        if i > 0 { argStr = argStr + ", " }
        argStr = argStr + emitExpr(args[i], depth, sc, sym)
        i = i + 1
    }
    let callName = cName(name)
    const qualName = tinfer.scopeLookup(sc, "__fnqual__" + name)
    if string_length(qualName) > 0 { callName = cName(qualName) }
    return callName + "(" + argStr + ")"
}

// ── Statement emission ─────────────────────────────────────────────────────────

fn emitStmt(stmt: compiler.Stmt, depth: int, sc: tinfer.Scope, sym: typeck.SymTable) -> string {
    const ind = indent(depth)
    const tag = match stmt {
        SLet(isMut, name, init) { yield "let" }
        SReturn(vals)           { yield "return" }
        SYield(e)               { yield "yield" }
        SDefer(e)               { yield "defer" }
        SContinue               { yield "continue" }
        SBreak                  { yield "break" }
        SExpr(e)                { yield "expr" }
        SAssign(target, val)             { yield "assign" }
        SCompoundAssign(target, op, val) { yield "compound" }
        SAnnotated(attrs, inner)         { yield "annotated" }
        SIf(c, th, el)                   { yield "if" }
        SWhile(cond, body)      { yield "while" }
        SFor(v, iter, body)     { yield "for" }
        SBlock(blk)             { yield "block" }
    }

    if tag == "let" {
        const isMut = match stmt { SLet(isMut, name, init) { yield isMut } _ { yield false } }
        const name  = match stmt { SLet(isMut, name, init) { yield name }  _ { yield "" } }
        const init  = match stmt { SLet(isMut, name, init) { yield init }  _ { yield compiler.nullExpr() } }
        return emitLet(name, init, depth, sc, sym)
    }

    if tag == "return" {
        const vals = match stmt { SReturn(vals) { yield vals } _ { yield compiler.emptyExprs() } }
        if vals.length == 0 { return ind + "return;\n" }
        if vals.length == 1 { return ind + "return " + emitExpr(vals[0], depth, sc, sym) + ";\n" }
        // Multi-return: pack into __TupleN
        let n = int_to_string(vals.length)
        let s = ind + "__Tuple" + n + "* __ret = (__Tuple" + n + "*)malloc(sizeof(__Tuple" + n + "));\n"
        let i = 0
        while i < vals.length {
            const ve = emitExpr(vals[i], depth, sc, sym)
            const si = int_to_string(i)
            // Always store directly as void* — __mr_get_N reads raw fields without unboxing
            // Booleans work as (void*)(int64_t)val (0 or 1 as pointer, truthy/falsy correct)
            const vty = tinfer.inferWithScope(vals[i], sc, sym)
            if vty == "bool" || vty == "int" {
                s = s + ind + "__ret->f" + si + " = (void*)(int64_t)(" + ve + ");\n"
            } else {
                s = s + ind + "__ret->f" + si + " = (void*)(" + ve + ");\n"
            }
            i = i + 1
        }
        s = s + ind + "return __ret;\n"
        return s
    }

    if tag == "yield"    { return "/* yield — handled by parent */\n" }
    if tag == "defer"    { return "/* defer — handled by parent */\n" }
    if tag == "continue" { return ind + "continue;\n" }
    if tag == "break"    { return ind + "break;\n" }

    if tag == "expr" {
        const e = match stmt { SExpr(e) { yield e } _ { yield compiler.nullExpr() } }
        const es = emitExpr(e, depth, sc, sym)
        if string_length(es) > 0 { return ind + es + ";\n" }
        return ""
    }

    if tag == "assign" {
        const target = match stmt { SAssign(t, v) { yield t } _ { yield compiler.nullExpr() } }
        const val    = match stmt { SAssign(t, v) { yield v } _ { yield compiler.nullExpr() } }
        return ind + emitExpr(target, depth, sc, sym) + " = " + emitExpr(val, depth, sc, sym) + ";\n"
    }

    if tag == "compound" {
        const target = match stmt { SCompoundAssign(t, op, v) { yield t }  _ { yield compiler.nullExpr() } }
        const op     = match stmt { SCompoundAssign(t, op, v) { yield op } _ { yield "+" } }
        const val    = match stmt { SCompoundAssign(t, op, v) { yield v }  _ { yield compiler.nullExpr() } }
        const te = emitExpr(target, depth, sc, sym)
        const ve = emitExpr(val, depth, sc, sym)
        return ind + te + " = " + te + " " + op + " " + ve + ";\n"
    }

    if tag == "annotated" {
        const inner = match stmt { SAnnotated(attrs, s) { yield s } _ { yield stmt } }
        return emitStmt(inner, depth, sc, sym)
    }

    if tag == "if" {
        const cond = match stmt { SIf(c, th, el) { yield c }  _ { yield compiler.nullExpr() } }
        const then = match stmt { SIf(c, th, el) { yield th } _ { yield compiler.emptyStmts() } }
        const els  = match stmt { SIf(c, th, el) { yield el } _ { yield compiler.emptyStmts() } }
        let s = ind + "if (" + emitExpr(cond, depth, sc, sym) + ") {\n"
        for st in then { s = s + emitStmt(st, depth + 1, sc, sym) }
        s = s + ind + "}\n"
        if els.length > 0 {
            s = s + ind + "else {\n"
            for st in els { s = s + emitStmt(st, depth + 1, sc, sym) }
            s = s + ind + "}\n"
        }
        return s
    }

    if tag == "while" {
        const cond = match stmt { SWhile(c, body) { yield c }    _ { yield compiler.nullExpr() } }
        const body = match stmt { SWhile(c, body) { yield body } _ { yield compiler.emptyStmts() } }
        let s = ind + "while (" + emitExpr(cond, depth, sc, sym) + ") {\n"
        for st in body { s = s + emitStmt(st, depth + 1, sc, sym) }
        s = s + ind + "}\n"
        return s
    }

    if tag == "for" {
        const varName = match stmt { SFor(v, iter, body) { yield v }    _ { yield "__it" } }
        const iter    = match stmt { SFor(v, iter, body) { yield iter }  _ { yield compiler.nullExpr() } }
        const body    = match stmt { SFor(v, iter, body) { yield body }  _ { yield compiler.emptyStmts() } }
        const arrVar = "__arr_" + cName(varName)
        const idxVar = "__i_"   + cName(varName)
        let s = ind + "{ void* " + arrVar + " = " + emitExpr(iter, depth, sc, sym) + ";\n"
        s = s + ind + "  int64_t __len_" + cName(varName) + " = haki_array_length(" + arrVar + ");\n"
        s = s + ind + "  for (int64_t " + idxVar + " = 0; " + idxVar + " < __len_" + cName(varName) + "; " + idxVar + "++) {\n"
        // Determine element type from the array's element type if known
        const iterTy = tinfer.inferWithScope(iter, sc, sym)
        let elemCType = "void*"
        let elemHakiTy = ""
        if string_length(iterTy) > 6 && iterTy.substring(0, 6) == "Array<" {
            const inner = iterTy.substring(6, string_length(iterTy) - 1)
            elemHakiTy = inner
            const innerC = cTy(inner)
            if innerC != "void*" && isSimpleCType(innerC) { elemCType = innerC }
            else {
                // Named struct type: get pointer type via cTy which handles module.Type → module__Type*
                if isSimpleCType(innerC) { elemCType = innerC }
                else {
                    const innerName = cName(inner)
                    if string_length(innerName) > 0 && isSimpleCType(innerName + "*") {
                        elemCType = innerName + "*"
                    }
                }
            }
        }
        // Update scope with element Haki type so field access on the loop variable resolves correctly
        if string_length(elemHakiTy) > 0 {
            tinfer.scopeSet(sc, varName, elemHakiTy)
        }
        s = s + indent(depth + 2) + elemCType + " " + cName(varName) + " = (" + elemCType + ")*(void**)haki_array_get(" + arrVar + ", " + idxVar + ");\n"
        for st in body { s = s + emitStmt(st, depth + 2, sc, sym) }
        s = s + ind + "  }\n"
        s = s + ind + "}\n"
        return s
    }

    if tag == "block" {
        const blk = match stmt { SBlock(blk) { yield blk } _ { yield compiler.emptyStmts() } }
        let s = ""
        for st in blk { s = s + emitStmt(st, depth, sc, sym) }
        return s
    }

    return ind + "/* unknown stmt */\n"
}

fn emitLet(name: string, init: compiler.Expr, depth: int, sc: tinfer.Scope, sym: typeck.SymTable) -> string {
    const ind = indent(depth)
    const nm = cName(name)
    if nm == "_" { return ind + "(void)(" + emitExpr(init, depth, sc, sym) + ");\n" }

    // Special: array literal → sequential append statements
    const isArr = match init {
        EArray(elems) { yield true }
        _ { yield false }
    }
    if isArr {
        const elems = match init { EArray(elems) { yield elems } _ { yield compiler.emptyExprs() } }
        let s = ind + "void* " + nm + " = haki_array_new(sizeof(void*));\n"
        for el in elems {
            const ev = emitExpr(el, depth, sc, sym)
            s = s + ind + "{ void* __el = (void*)(" + ev + "); haki_array_append(" + nm + ", &__el); }\n"
        }
        return s
    }

    // Special: struct/Error construction → sequential field assignment
    const isCall = match init {
        ECall(n, args) { yield true }
        _ { yield false }
    }
    if isCall {
        const callName = match init { ECall(n, args) { yield n } _ { yield "" } }
        const callArgs = match init { ECall(n, args) { yield args } _ { yield compiler.emptyExprs() } }
        if callName == "Error" && callArgs.length == 1 {
            return ind + "void* " + nm + " = haki_error_new(" + emitExpr(callArgs[0], depth, sc, sym) + ");\n"
        }
    }

    // Default: use type inference to emit the correct C type
    const initStr = emitExpr(init, depth, sc, sym)
    const inferredTy = tinfer.inferWithScope(init, sc, sym)
    const ctype = cTy(inferredTy)
    // Update scope with inferred type for subsequent statements
    tinfer.scopeSet(sc, name, inferredTy)
    if ctype == "int64_t" { return ind + "int64_t " + nm + " = " + initStr + ";\n" }
    if ctype == "double"  { return ind + "double " + nm + " = " + initStr + ";\n" }
    if ctype == "int8_t"  { return ind + "int8_t " + nm + " = " + initStr + ";\n" }
    if ctype == "const char*" { return ind + "const char* " + nm + " = " + initStr + ";\n" }
    if ctype == "void*"   { return ind + "void* " + nm + " = (void*)(" + initStr + ");\n" }
    // Use the inferred struct pointer type only when it is a valid simple C type
    // (no tuple types, no generic params, no '?' etc. which produce invalid C).
    if isSimpleCType(ctype) { return ind + ctype + " " + nm + " = (" + ctype + ")(" + initStr + ");\n" }
    // Fall back to void* for complex/tuple Haki return types
    return ind + "void* " + nm + " = (void*)(" + initStr + ");\n"
}

// ── Function emission ──────────────────────────────────────────────────────────

fn emitFnProto(f: mono.MonoFn) -> string {
    const ret = cRetTy(f.retTy)
    let params = ""
    let i = 0
    while i < f.params.length {
        if i > 0 { params = params + ", " }
        params = params + cTy(f.params[i].ty) + " " + cName(f.params[i].name)
        i = i + 1
    }
    if f.name == "main" {
        return "int main(int argc, char** argv)"
    }
    if string_length(params) == 0 { params = "void" }
    return ret + " " + cName(f.name) + "(" + params + ")"
}

fn emitFn(f: mono.MonoFn, sym: typeck.SymTable, enums: Array<mono.EnumDef>, structs: Array<compiler.StructDef>, fns: Array<mono.MonoFn>) -> string {
    // Build type inference scope for this function.
    const fnDef = compiler__makeFnDef(f.name, f.params, f.retTy, f.body)
    const sc = tinfer.buildFnScope(fnDef, sym)
    // Inject enum variant discriminants into scope as meta-entries "__v__VarName" → index
    // Variants may be stored as "VarName:PayloadType" — split on first ":" to extract both.
    for edef in enums {
        let vi = 0
        while vi < edef.variants.length {
            const combined = edef.variants[vi]
            // Split on first ":"
            let vname = combined
            let vpayTy = ""
            let ci = 0
            while ci < string_length(combined) {
                if combined.substring(ci, ci + 1) == ":" {
                    vname = combined.substring(0, ci)
                    vpayTy = combined.substring(ci + 1, string_length(combined))
                    ci = string_length(combined)  // break
                }
                ci = ci + 1
            }
            tinfer.scopeSet(sc, "__v__" + vname, int_to_string(vi))
            if string_length(vpayTy) > 0 {
                tinfer.scopeSet(sc, "__vt__" + vname, vpayTy)
            }
            vi = vi + 1
        }
    }
    // Inject struct field lists and field types into scope
    // "__sf__StructName" → "f1,f2,..." and "__sft__StructName__fieldName" → type
    // Also inject unqualified names (strip module prefix) for cross-module field access.
    for s in structs {
        let fieldStr = ""
        let fi = 0
        // Compute unqualified struct name (strip "module__" prefix)
        let unqualSname = s.name
        let lastSepS = 0
        let sni = 0
        const snlen = string_length(s.name)
        while sni < snlen - 1 {
            if s.name.substring(sni, sni + 2) == "__" {
                lastSepS = sni + 2
            }
            sni = sni + 1
        }
        if lastSepS > 0 { unqualSname = s.name.substring(lastSepS, snlen) }
        while fi < s.fields.length {
            if fi > 0 { fieldStr = fieldStr + "," }
            fieldStr = fieldStr + s.fields[fi].name
            tinfer.scopeSet(sc, "__sft__" + s.name + "__" + s.fields[fi].name, s.fields[fi].ty)
            // Also inject with unqualified struct name for cross-module lookups
            if unqualSname != s.name {
                tinfer.scopeSet(sc, "__sft__" + unqualSname + "__" + s.fields[fi].name, s.fields[fi].ty)
            }
            fi = fi + 1
        }
        tinfer.scopeSet(sc, "__sf__" + s.name, fieldStr)
        if unqualSname != s.name {
            tinfer.scopeSet(sc, "__sf__" + unqualSname, fieldStr)
        }
    }
    // Inject function return types as meta-entries "__fn__name" → retTy
    // This enables inferWithScope to return proper struct types for function calls.
    // We inject both the full name (e.g. "compiler__lexerNew") and the unqualified
    // suffix after the last "__" (e.g. "lexerNew") so same-module calls resolve too.
    for mf in fns {
        tinfer.scopeSet(sc, "__fn__" + mf.name, mf.retTy)
        // Extract unqualified name: find last __ and take suffix
        let lastSep = 0
        let fni = 0
        const fnlen = string_length(mf.name)
        while fni < fnlen - 1 {
            if mf.name.substring(fni, fni + 2) == "__" {
                lastSep = fni + 2
            }
            fni = fni + 1
        }
        if lastSep > 0 {
            const unqualName = mf.name.substring(lastSep, fnlen)
            tinfer.scopeSet(sc, "__fn__" + unqualName, mf.retTy)
            // Also inject qualified name mapping so emitCall can use the correct C name
            // "__fnqual__unqualName" → "module__unqualName" (the C function's real name)
            tinfer.scopeSet(sc, "__fnqual__" + unqualName, mf.name)
        }
    }

    let s = emitFnProto(f) + " {\n"
    if f.name == "main" {
        s = s + "    haki_runtime_init(argc, argv);\n"
    }
    for stmt in f.body {
        s = s + emitStmt(stmt, 1, sc, sym)
    }
    if f.retTy == "void" || f.retTy == "" {
        if f.name == "main" { s = s + "    return 0;\n" }
    }
    s = s + "}\n\n"
    return s
}

// ── Struct field type for definitions ─────────────────────────────────────────
// Check if a ctype string is a valid, simple C type that can be used in variable
// declarations. Complex Haki types like "(Array<Item>, Error?)" produce invalid C.
// A valid simple type is: all chars are alphanumeric, '_', '*', or matches
// "const char*". Returns true if safe to use directly in C, false if should fall
// back to void*.
fn isSimpleCType(ct: string) -> bool {
    const n = string_length(ct)
    if n == 0 { return false }
    // Allow known primitives
    if ct == "int64_t" { return true }
    if ct == "double"  { return true }
    if ct == "int8_t"  { return true }
    if ct == "const char*" { return true }
    if ct == "void*"   { return true }
    if ct == "void"    { return true }
    // For pointer types like "Lexer*", "MonoFn*", etc.: must be ident + '*'
    // with no spaces, parens, angle brackets, commas, or '?'
    let i = 0
    while i < n {
        const ch = ct.substring(i, i + 1)
        if ch == "(" { return false }
        if ch == ")" { return false }
        if ch == "<" { return false }
        if ch == ">" { return false }
        if ch == "," { return false }
        if ch == "?" { return false }
        if ch == " " { return false }
        i = i + 1
    }
    return true
}

// Use void* for anything that isn't a C primitive — this covers enum types
// (which are void* tagged unions) and nested struct types. Using the precise
// struct pointer type causes "unknown type name" errors for enum types.
fn cStructFieldTy(ty: string) -> string {
    if ty == "int"    { return "int64_t" }
    if ty == "float"  { return "double" }
    if ty == "bool"   { return "int8_t" }
    if ty == "string" { return "const char*" }
    // Arrays, maps, enums, structs, nullable types → opaque void*
    return "void*"
}

// ── Struct emission ────────────────────────────────────────────────────────────

fn emitStructDef(s: compiler.StructDef) -> string {
    if string_length(s.name) == 0 { return "" }
    let out = "struct " + cName(s.name) + " {\n"
    for f in s.fields {
        out = out + "    " + cStructFieldTy(f.ty) + " " + cName(f.name) + ";\n"
    }
    if s.fields.length == 0 { out = out + "    int _dummy;\n" }
    out = out + "};\n"
    return out
}

// ── Tuple struct pre-declarations ─────────────────────────────────────────────

fn tupleStructs() -> string {
    let s = "/* Tuple structs for multi-return */\n"
    let n = 2
    while n <= 4 {
        s = s + "typedef struct { "
        let i = 0
        while i < n {
            s = s + "void* f" + int_to_string(i) + "; "
            i = i + 1
        }
        s = s + "} __Tuple" + int_to_string(n) + ";\n"
        n = n + 1
    }
    return s + "\n"
}

// ── Full program emission ──────────────────────────────────────────────────────

fn emitProgram(prog: mono.MonoProgram, runtimeSrc: string) -> string {
    // Use an empty sym table. Scope from function params is sufficient
    // for most operator disambiguation.
    const sym = typeck.symNew()

    let out = "/* Generated by hakic --emit-c (Haki bootstrap emitter) */\n"
    out = out + "/* Compile: gcc -std=gnu11 -O2 -lpthread -lm -o out this.c */\n\n"

    // Embed core runtime
    out = out + runtimeSrc + "\n"

    // Tuple struct pre-declarations
    out = out + tupleStructs()

    // Enum typedefs: enums are void* tagged unions in C.
    // We emit BOTH a qualified alias (module__EnumName → void*) and
    // an unqualified alias (EnumName → void) so that code using the bare
    // name can write EnumName* and have it resolve to void*.
    // "typedef void EnumName;" means EnumName*  ==  void*  in C.
    out = out + "/* Enum typedefs (tagged unions represented as void*) */\n"
    for edef in prog.enums {
        if string_length(edef.name) > 0 {
            const qualName = cName(edef.name)
            out = out + "typedef void* " + qualName + ";\n"
            // Extract unqualified suffix after last "__" for the bare typedef
            let lastUs = 0
            let eni = 0
            const enlen = string_length(edef.name)
            while eni < enlen - 1 {
                if edef.name.substring(eni, eni + 2) == "__" {
                    lastUs = eni + 2
                }
                eni = eni + 1
            }
            const unqualEnumName = if lastUs > 0 { yield edef.name.substring(lastUs, enlen) } else { yield edef.name }
            if unqualEnumName != qualName {
                out = out + "typedef void " + unqualEnumName + ";\n"
            }
        }
    }
    out = out + "\n"

    // Struct forward declarations
    out = out + "/* Forward declarations */\n"
    // Emit forward declarations for all merged struct types.
    // These come from imported modules (compiler, typeck, mono, cemit).
    for s in prog.structs {
        if string_length(s.name) > 0 {
            out = out + "typedef struct " + cName(s.name) + " " + cName(s.name) + ";\n"
        }
    }
    // Module-qualified typedef aliases — map module__Type → the unqualified struct Type.
    // This resolves "invalid use of incomplete typedef 'mono__MonoFn'" errors because
    // struct definitions are emitted unqualified (e.g. "struct MonoFn") but function
    // prototypes reference the qualified name (e.g. "mono__MonoFn*").
    out = out + "typedef struct MonoProgram mono__MonoProgram;\n"
    out = out + "typedef struct MonoFn mono__MonoFn;\n"
    out = out + "typedef struct EnumDef mono__EnumDef;\n"
    out = out + "typedef struct FnDef compiler__FnDef;\n"
    out = out + "typedef struct StructDef compiler__StructDef;\n"
    out = out + "typedef struct Param compiler__Param;\n"
    out = out + "typedef struct MatchArm compiler__MatchArm;\n"
    out = out + "typedef struct Token compiler__Token;\n"
    out = out + "typedef struct SymTable typeck__SymTable;\n"
    out = out + "typedef struct FnInfo typeck__FnInfo;\n"
    out = out + "typedef struct Scope tinfer__Scope;\n"
    out = out + "typedef struct TypedExpr tinfer__TypedExpr;\n"
    out = out + "\n"

    // Function prototypes
    out = out + "/* Function prototypes */\n"
    for f in prog.fns {
        out = out + emitFnProto(f) + ";\n"
    }
    out = out + "\n"

    // Struct definitions
    out = out + "/* Struct definitions */\n"
    for s in prog.structs {
        out = out + emitStructDef(s)
    }
    out = out + "\n"

    // Function definitions
    out = out + "/* Functions */\n"
    for f in prog.fns {
        out = out + emitFn(f, sym, prog.enums, prog.structs, prog.fns)
    }

    return out
}

// ── Full pipeline ──────────────────────────────────────────────────────────────

fn compileToC(src: string, runtimeSrc: string) -> (string, Error?) {
    const prog, err = mono.monoFromSource(src)
    if err != null { return "", err }
    return emitProgram(prog, runtimeSrc), null
}

// ── Tests ──────────────────────────────────────────────────────────────────────

fn test_c_name() {
    if cName("int") != "haki_int"   { panic("cName int wrong") }
    if cName("foo") != "foo"         { panic("cName foo wrong") }
    if cName("add") != "add"         { panic("cName add wrong") }
}

fn test_c_ty() {
    if cTy("int")    != "int64_t"   { panic("cTy int wrong") }
    if cTy("string") != "const char*" { panic("cTy string wrong") }
    if cTy("bool")   != "int8_t"    { panic("cTy bool wrong") }
    if cTy("void")   != "void"      { panic("cTy void wrong") }
}

fn test_escape_str() {
    const s = escapeStr("hello\nworld")
    if s != "hello\\nworld" { panic("escapeStr wrong: " + s) }
}

fn test_emit_proto() {
    let params: Array<compiler.Param> = []
    let body: Array<compiler.Stmt> = []
    const mf = mono.makeMonoFn("add", params, "int", body)
    const proto = emitFnProto(mf)
    if proto != "int64_t add(void)" { panic("proto wrong: " + proto) }
}

fn main() {
    const miniSrc = "fn add(a: int, b: int) -> int { return a + b }\nfn main() { print_int(add(1, 2)) }"
    const c, err = compileToC(miniSrc, "/* runtime stub */")
    if err != null {
        print("error: " + err.message)
        return
    }
    print("emitted " + int_to_string(string_length(c)) + " bytes of C")
    print("done")
}
